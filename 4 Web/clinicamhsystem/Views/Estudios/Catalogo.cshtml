@model List<ClinicaDomain.CatalogoIndicacion>
@using ClinicaDomain
@{
    ViewData["Title"] = "Catálogo Indicaciones";
}
<div class="card shadow-lg p-3 mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h4><i class="fa-solid fa-list" style="color:#2d8f77"></i> Catálogo Indicaciones</h4>
        <a href="@Url.Action("Index","Estudios")" class="btn btn-outline-secondary btn-sm">Volver a Carga</a>
    </div>
    <div class="card-body">
        <form method="post" action="@Url.Action("CrearCatalogo")" class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-2">
                <label class="fw-bold small">Tipo</label>
                <select name="tipo" class="form-select form-select-sm" required>
                    @foreach(var t in Enum.GetValues(typeof(TipoEstudio)).Cast<TipoEstudio>()){
                        <option value="@((int)t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <label class="fw-bold small">Código</label>
                <input name="codigo" class="form-control form-control-sm" placeholder="Ej: RX-PERI" maxlength="50" />
            </div>
            <div class="col-12 col-md-6">
                <label class="fw-bold small">Descripción</label>
                <input name="descripcion" class="form-control form-control-sm" placeholder="Ej: Rx periapical pieza" maxlength="300" required />
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-dark btn-sm w-100"><i class="fa-solid fa-plus"></i> Agregar</button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead class="table-light"><tr><th>Tipo</th><th>Código</th><th>Descripción</th><th>Activo</th><th></th></tr></thead>
                <tbody>
                @foreach(var c in Model.OrderBy(x=>x.Tipo).ThenBy(x=>x.Descripcion)){
                    <tr>
                        <td><span class="badge bg-primary">@c.Tipo</span></td>
                        <td><small>@c.Codigo</small></td>
                        <td>@c.Descripcion</td>
                        <td>
                            <form method="post" action="@Url.Action("ToggleCatalogo")" style="display:inline">
                                <input type="hidden" name="id" value="@c.IdCatalogo" />
                                <button type="submit" class="btn btn-sm @(c.Activo?"btn-success":"btn-secondary")">@(c.Activo?"Activo":"Inactivo")</button>
                            </form>
                        </td>
                        <td class="text-end text-nowrap">
                            <partial name="_AuditInfo" model="c" />
                            <form method="post" action="@Url.Action("EliminarCatalogo")" style="display:inline" onsubmit="return confirm('¿Eliminar?')">
                                <input type="hidden" name="id" value="@c.IdCatalogo" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/pages/audit-info.js" asp-append-version="true"></script>
}
