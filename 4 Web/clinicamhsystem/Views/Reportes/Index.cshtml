                                <div class="small text-muted mb-1">Detalle del día — @kvd.Value.Count movimiento(s) en @gruposServ.Count servicio(s). Pulse <strong>+</strong> de cada servicio para ver los movimientos.</div>
                                <table class="table table-sm table-bordered mb-0 micro-table">
                                    <thead class="table-light">
                                        <tr><th style="width:42px;"></th><th>Servicio / Producto</th><th>Movimientos</th><th>Cantidad</th><th>Subtotal</th></tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var gj = 0;
                                        }
                                        @foreach (var gs in gruposServ)
                                        {
                                            gj++;
                                            var cantGs = gs.Sum(x => x.Cantidad);
                                            var subGs = gs.Sum(x => x.Subtotal);
                                            var unoSoloGs = gs.Count() == 1;
                                            <tr class="micro-n2-head @(gj % 2 == 1 ? "micro-fecha-a" : "micro-fecha-b")">
                                                <td><button type="button" class="btn-micro-n2 btn btn-sm btn-outline-secondary" title="Ver movimientos del servicio">@(unoSoloGs ? "−" : "+")</button></td>
                                                <td class="fw-bold">@gs.Key</td>
                                                <td>@gs.Count()</td>
                                                <td>@cantGs</td>
                                                <td>Q @subGs</td>
                                            </tr>
                                            <tr class="micro-n2-det" style="@(unoSoloGs ? "" : "display:none;")">
                                                <td></td>
                                                <td colspan="4" class="p-1">
                                                    <table class="table table-sm table-bordered mb-0 micro-n2-table">
                                                        <thead class="table-light">
                                                            <tr><th>Paciente</th><th>Origen</th><th>Tipo pago</th><th>Cantidad</th><th>Subtotal</th></tr>
