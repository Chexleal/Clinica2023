@model ConsultaContinuarViewModel
@using ClinicaDomain

<!-- Modal Nota Médica -->
@{
    var nota = Model.NotaMedica ?? new NotaMedica
    {
        IdConsulta = Model.Consulta.IdConsulta,
        IdPaciente = Model.Consulta.IdPaciente,
        Motivo = Model.Consulta.MotivoConsulta ?? "",
        IncluirMotivo = false
    };
}

<div class="modal fade" id="modalNotaMedica" tabindex="-1" role="dialog" aria-labelledby="modalNotaMedica" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-file-medical" style="color:#2d8f77"></i> Nota Médica <small class="text-muted" style="font-size:13px;">referencia / interconsulta</small></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formNotaMedica" method="post" action="@Url.Action("GuardarNotaMedica")">
                    <input type="hidden" name="IdNotaMedica" value="@nota.IdNotaMedica" />
                    <input type="hidden" name="IdConsulta" value="@Model.Consulta.IdConsulta" />
                    <input type="hidden" name="IdPaciente" value="@Model.Consulta.IdPaciente" />
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="fw-bold small">Motivo / Asunto</label>
                            <input name="Motivo" class="form-control form-control-sm" value="@nota.Motivo" placeholder="Ej: Constancia de reposo, referencia a fisioterapia..." maxlength="500" />
                        </div>
                        <div class="col-12">
                            <label class="fw-bold small">Contenido de la nota</label>
                            <textarea name="Contenido" class="form-control" rows="6" maxlength="4000" placeholder="Hallazgos, diagnóstico, tratamiento actual y recomendaciones...">@nota.Contenido</textarea>
                            <small class="text-muted">El motivo y el diagnóstico de la consulta se incluyen al imprimir solo si los marcas.</small>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IncluirMotivo" id="notaIncluirMotivo" value="true" @(nota.IncluirMotivo ? "checked" : "")>
                                <input type="hidden" name="IncluirMotivo" value="false" />
                                <label class="form-check-label small" for="notaIncluirMotivo">Incluir motivo de consulta</label>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IncluirDiagnostico" id="notaIncluirDiagnostico" value="true" @(nota.IncluirDiagnostico ? "checked" : "")>
                                <input type="hidden" name="IncluirDiagnostico" value="false" />
                                <label class="form-check-label small" for="notaIncluirDiagnostico">Incluir diagnóstico</label>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12 d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-dark btn-sm"><i class="fa-solid fa-floppy-disk"></i> Guardar</button>
                            <button type="submit" name="imprimir" value="true" formtarget="_blank" class="btn btn-outline-dark btn-sm"><i class="fa-solid fa-print"></i> Guardar e imprimir</button>
                            @if (nota.IdNotaMedica != Guid.Empty)
                            {
                                <a href="@Url.Action("ImprimirNotaMedica", new { idConsulta = Model.Consulta.IdConsulta })" target="_blank" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-print"></i> Imprimir nota</a>
                            }
                            else
                            {
                                <span class="text-muted small align-self-center"><i class="fa-solid fa-circle-info"></i> Guarda primero para habilitar impresión.</span>
                            }
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
