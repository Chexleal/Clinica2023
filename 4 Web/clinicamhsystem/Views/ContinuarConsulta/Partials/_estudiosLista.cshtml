@model List<ClinicaDomain.EstudioImagen>
@using ClinicaDomain
@{
    var soloLectura = ViewBag.EsSoloLectura as bool? ?? false;
    // En ContinuarConsulta doctor solo visualiza, en Estudios carga sí puede eliminar
    var controllerVer = soloLectura ? "ContinuarConsulta" : (ViewContext.RouteData.Values["controller"]?.ToString() ?? "Estudios");
}
@if (Model == null || !Model.Any())
{
    <div class="text-center py-4 text-muted"><i class="fa-solid fa-images fa-2x"></i><p class="mt-2 small">Sin estudios cargados</p></div>
}
else
{
    <div class="row g-3" id="galeriaEstudios">
    @foreach (var est in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center gap-2">
                    <span class="badge @(est.Tipo==TipoEstudio.Laboratorio?"bg-warning text-dark":"bg-primary")">@est.Tipo</span>
                    @{ var indicHeader = est.Orden != null && !string.IsNullOrWhiteSpace(est.Orden.Indicacion) ? est.Orden.Indicacion : est.Descripcion; }
                    @if(!string.IsNullOrWhiteSpace(indicHeader)){<small class="text-dark fw-semibold text-truncate flex-grow-1 text-center" style="font-size:12.5px" title="@indicHeader">@indicHeader</small>}
                    <small class="text-muted text-nowrap" title="Fecha del estudio">@est.FechaEstudio.ToString("dd/MM/yyyy")</small>
                </div>
                <div class="card-body py-2">
                    @{ var tituloAuto = $"{est.Tipo} {est.FechaEstudio:yyyy-MM-dd}"; }
                    @if(!string.IsNullOrWhiteSpace(est.Titulo) && est.Titulo.Trim() != tituloAuto){<h6 class="card-title mb-1" style="font-size:14px">@est.Titulo</h6>}
                    @if(!string.IsNullOrWhiteSpace(est.Descripcion)){<p class="card-text small text-muted mb-1">@est.Descripcion</p>}
                    <div class="mt-2">
                        <small class="text-muted" title="Registro creado por este usuario en esta fecha"><i class="fa-solid fa-user"></i> @(est.CreadoPorNombre ?? est.CreadoPor?.ToString() ?? "-") · @est.FechaCreacion?.ToString("dd/MM/yyyy") | <i class="fa-solid fa-hard-drive"></i> @(est.Archivos.Sum(a=>a.TamanoBytes) >= 1048576 ? (est.Archivos.Sum(a=>a.TamanoBytes)/1048576.0).ToString("0.0") + " MB" : (est.Archivos.Sum(a=>a.TamanoBytes)/1024.0).ToString("0") + " KB") total</small>
                    </div>
                    <ul class="list-group list-group-flush mt-2 rx-arch-list">
                    @foreach(var arch in est.Archivos)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-1 px-0 rx-arch-item" style="font-size:13px" data-arch="@arch.IdArchivo" data-nombre="@arch.NombreOriginal" data-mime="@arch.MimeType">
                            <span class="text-truncate me-2" title="@arch.NombreOriginal">@{ var icono = arch.MimeType.Contains("dicom") ? "fa-x-ray text-info" : arch.MimeType.Contains("pdf") ? "fa-file-pdf text-danger" : arch.MimeType.StartsWith("image/") ? "fa-file-image text-success" : "fa-file-lines text-secondary"; }<i class="fa-solid @icono"></i> @arch.NombreOriginal <small class="text-muted">(@((arch.TamanoBytes/1024.0).ToString("0")) KB)</small></span>
                            <span class="btn-group btn-group-sm">
                                @if(arch.MimeType.Contains("dicom")){
                                    <button type="button" class="btn btn-outline-dark btn-sm btn-ver-dicom rx-drag-source" draggable="true" data-arch="@arch.IdArchivo" data-nombre="@arch.NombreOriginal" title="Clic para ver • Arrastra al visor"><i class="fa-solid fa-eye"></i> <i class="fa-solid fa-grip-vertical text-muted"></i></button>
                                } else {
                                    <a href="@Url.Action("VerArchivo", controllerVer, new{idArchivo=arch.IdArchivo})" target="_blank" class="btn btn-outline-secondary btn-sm" title="Ver"><i class="fa-solid fa-eye"></i></a>
                                }
                                @if(!soloLectura){
                                <button type="button" class="btn btn-outline-danger btn-sm btn-del-arch" data-arch="@arch.IdArchivo"><i class="fa-solid fa-trash"></i></button>
                                }
                            </span>
                        </li>
                    }
                    </ul>
                </div>
                @if(!soloLectura){
                <div class="card-footer bg-white py-1 d-flex justify-content-between align-items-center">
                    <div>
                        <input type="file" class="d-none input-add-more-estudio" multiple accept=".dcm,.pdf,.jpg,.jpeg,.png" data-estudio="@est.IdEstudio" />
                        <button type="button" class="btn btn-sm btn-outline-primary btn-add-more-estudio" data-estudio="@est.IdEstudio" title="Agregar RX faltantes a este mismo grupo"><i class="fa-solid fa-plus"></i> Agregar</button>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger btn-del-estudio" data-estudio="@est.IdEstudio"><i class="fa-solid fa-trash-can"></i> Eliminar estudio</button>
                </div>
                }
            </div>
        </div>
    }
    </div>
}
