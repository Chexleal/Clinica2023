@model List<ClinicaDomain.Cotizacion>
@{
    ViewData["Title"] = "Cotizaciones";
    var historial = (List<ClinicaDomain.Cotizacion>)(ViewBag.Historial ?? new List<ClinicaDomain.Cotizacion>());
    var pacientesMap = (Dictionary<Guid, string>)(ViewBag.PacientesMap ?? new Dictionary<Guid, string>());
    string NomPaciente(ClinicaDomain.Cotizacion c) =>
        c.IdPaciente.HasValue && pacientesMap.TryGetValue(c.IdPaciente.Value, out var n) ? n
        : string.IsNullOrWhiteSpace(c.ClienteNombre) ? "Mostrador" : c.ClienteNombre!;
    string BadgeEstado(string e) => e switch
    {
        "Vigente" => "bg-success",
        "Borrador" => "bg-secondary",
        "Vencida" => "bg-warning text-dark",
        "Aceptada" => "bg-primary",
        "Rechazada" => "bg-dark",
        _ => "bg-danger"
    };
    var tabActiva = Model.Any() ? "activas" : "historial";
}
@section Links{
    <style>
        /* Barra contenedora: separa los tabs del fondo de la página (igual que Ventas mostrador) */
        .tabs-subnav { background: #e9f0ed; border: 1px solid #dee2e6; border-bottom: 0; border-radius: 10px 10px 0 0; padding: 6px 10px 0; gap: 4px; }
        .tabs-subnav .nav-link { border: 0; border-radius: 8px 8px 0 0; color: #495057; font-weight: 500; padding: 10px 14px; position: relative; }
        .tabs-subnav .nav-link:hover { color: #2d8f77; background: #fff; }
        .tabs-subnav .nav-link.active { color: #2d8f77; font-weight: 700; background: #fff; }
        .tabs-subnav .nav-link.active::after { content: ""; position: absolute; left: 8px; right: 8px; bottom: 0; height: 3px; border-radius: 3px 3px 0 0; background: #2d8f77; }
        .tabs-subnav .nav-link .badge { font-weight: 600; }
        /* El card se fusiona con la barra (sin borde superior ni esquinas de arriba) */
        .tabs-panel { border-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; }
    </style>
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-5">
    <h3 class="h3 mb-0">Cotizaciones</h3>
    <span class="text-muted small">Precios estimados · <b>no mueven inventario</b> ni son cobro</span>
</div>
<ul class="nav tabs-subnav mt-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(tabActiva == "activas" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabActivas" type="button" role="tab"><i class="fa-solid fa-file-invoice"></i> Vigentes y borradores <span class="badge @(tabActiva == "activas" ? "bg-success" : "bg-secondary")">@Model.Count</span></button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(tabActiva == "historial" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabHistorial" type="button" role="tab"><i class="fa-solid fa-clock-rotate-left"></i> Historial <span class="badge @(tabActiva == "historial" ? "bg-success" : "bg-secondary")">@historial.Count</span></button>
    </li>
</ul>
<div class="card w-100 shadow-lg mt-0 border-top-0 tabs-panel">
    <div class="card-body">
        <div class="tab-content">
            <div class="tab-pane fade @(tabActiva == "activas" ? "show active" : "")" id="tabActivas" role="tabpanel">
                <form method="POST" action="@Url.Action("Crear", "Cotizaciones")" class="row g-2 align-items-end mb-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label class="form-label small">Paciente (opcional)</label>
                        <select name="idPaciente" id="nuevoPaciente" class="form-select form-select-sm" style="width:100%"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Cliente (si no hay paciente)</label>
                        <input name="clienteNombre" class="form-control form-control-sm" maxlength="200" placeholder="Nombre libre" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Vigencia (días)</label>
                        <input name="vigenciaDias" type="number" min="1" max="365" value="15" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Nota</label>
                        <input name="observaciones" class="form-control form-control-sm" maxlength="300" placeholder="Opcional" />
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-dark btn-sm w-100 text-nowrap"><i class="fa-solid fa-plus"></i> Nueva</button>
                    </div>
                </form>
                <div class="table-responsive">
                    <table class="table table-striped tabla-config" data-search-placeholder="Buscar cotización" data-export-name="CotizacionesActivas">
                        <thead class="table-dark">
                            <tr><th>Folio</th><th>Fecha</th><th>Vence</th><th>Cliente</th><th>Total</th><th>Estado</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr class="@(c.Estado == "Vencida" ? "table-warning" : "")">
                                    <td>@c.Folio</td>
                                    <td>@c.Fecha.ToString("g")</td>
                                    <td>@(c.FechaVence.HasValue ? c.FechaVence.Value.ToString("dd/MM/yyyy") : "—")</td>
                                    <td>@NomPaciente(c)</td>
                                    <td>Q@(c.Total.ToString("0.00"))</td>
                                    <td><span class="badge @BadgeEstado(c.Estado)">@c.Estado</span></td>
                                    <td class="text-nowrap"><partial name="_AuditInfo" model="c" /><a class="btn btn-outline-info btn-sm" href="@Url.Action("Editar", "Cotizaciones", new { id = c.IdCotizacion })">Abrir</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade @(tabActiva == "historial" ? "show active" : "")" id="tabHistorial" role="tabpanel">
                <form method="get" class="row g-2 align-items-end mb-3">
                    <div class="col-auto"><label class="form-label small">Desde</label><input type="date" name="from" value="@ViewBag.HistorialFrom" class="form-control form-control-sm" /></div>
                    <div class="col-auto"><label class="form-label small">Hasta</label><input type="date" name="to" value="@ViewBag.HistorialTo" class="form-control form-control-sm" /></div>
                    <div class="col-md-4"><label class="form-label small">Texto</label><input name="texto" value="@ViewBag.HistorialTexto" class="form-control form-control-sm" placeholder="Folio, cliente, nota…" /></div>
                    <div class="col-auto"><button class="btn btn-outline-secondary btn-sm" type="submit">Filtrar</button></div>
                </form>
                <div class="table-responsive">
                    <table class="table table-striped tabla-config" data-search-placeholder="Buscar en historial" data-export-name="CotizacionesHistorial">
                        <thead class="table-dark">
                            <tr><th>Folio</th><th>Fecha</th><th>Cliente</th><th>Total</th><th>Estado</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in historial)
                            {
                                <tr>
                                    <td>@c.Folio</td>
                                    <td>@c.Fecha.ToString("g")</td>
                                    <td>@NomPaciente(c)</td>
                                    <td>Q@(c.Total.ToString("0.00"))</td>
                                    <td><span class="badge @BadgeEstado(c.Estado)">@c.Estado</span></td>
                                    <td class="text-nowrap"><partial name="_AuditInfo" model="c" /><a class="btn btn-outline-info btn-sm" href="@Url.Action("Editar", "Cotizaciones", new { id = c.IdCotizacion })">Ver</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_DataTablesButtonsScripts" />
    <script src="~/js/pages/audit-info.js" asp-append-version="true"></script>
    <script>
        $(function () {
            $('#nuevoPaciente').select2({
                placeholder: 'Sin paciente (mostrador)',
                allowClear: true,
                ajax: {
                    url: '@Url.Action("GetPacientesSelect", "Cotizaciones")',
                    dataType: 'json', delay: 250,
                    data: function (params) { return { q: params.term, page: params.page || 1 }; },
                    processResults: function (data, params) {
                        params.page = params.page || 1;
                        return { results: data.results, pagination: { more: data.more } };
                    }
                }
            });
        });
    </script>
}
