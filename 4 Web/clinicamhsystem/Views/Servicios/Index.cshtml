@model clinicaWeb.Models.ServiciosViewModel;

@{
    ViewData["Title"] = "Catálogo Servicios";
}
<div class="card shadow-lg p-3 mb-4">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h4><i class="fa-solid fa-hand-holding-medical" style="color:#2d8f77"></i> Catálogo Servicios</h4>
        <a href="@Url.Action("Index","Configuraciones")" class="btn btn-outline-secondary btn-sm">Volver a Configuraciones</a>
    </div>

    <div class="card-body">
        <form method="POST" action="@Url.Action("Create","Servicios")" class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-10">
                <label class="fw-bold small">Servicio</label>
                <input required name="Descripcion" id="Descripcion" class="form-control form-control-sm" placeholder="Ej: Consulta general" maxlength="300" />
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-dark btn-sm w-100"><i class="fa-solid fa-plus"></i> Agregar</button>
            </div>
        </form>
        <div class="table-responsive ">
            <table id="table" class="table table-sm table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Servicio</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Servicios)
                    {
                        <tr>
                            <td>@item.Descripcion</td>
                            <td class="text-end text-nowrap">
                                <partial name="_AuditInfo" model="item" />
                                <button class="btn btn-sm btn-outline-danger" type="button" onclick="alertElminarPrevents('@item.IdMotivoCobro')"><i class="fa-solid fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@section Scripts{
    <script>

        function alertElminarPrevents(id) {
            Swal.fire({
                title: '¿Esta seguro de eliminar este servicio?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Si',
                cancelButtonText: 'No'
            }).then((resultado) => {

                if (resultado.isConfirmed) {
                    $.ajax({
                        url: '/Servicios/Eliminar',
                        type: 'POST',
                        data: {id : id},
                        success: function (result) {
successWithTimer('/Servicios/Index')
                        },
                        error: function (error) {
                            console.log(error);
                        }
                    });
                    //successWithTimer('eliminarForm');
                }

            })
        }
    </script>
    <partial name="_DataTablesButtonsScripts" />
    <script src="~/js/pages/audit-info.js" asp-append-version="true"></script>
    <script src="~/js/pages/servicios.js" asp-append-version="true"></script>
}