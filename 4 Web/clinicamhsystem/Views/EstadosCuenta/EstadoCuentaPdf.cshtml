@model ClinicaServices.EstadoCuenta
@{ Layout=null; var v=Model.Venta; var atencion=v.ServicioAtencion; var emergencia=v.TipoAtencion==ClinicaDomain.TipoAtencion.Emergencia; }
<!doctype html><html lang="es"><head><meta charset="utf-8"/><title>Estado de cuenta @v.Folio</title><style>
*{box-sizing:border-box}body{font:12px Arial,sans-serif;color:#222;margin:28px;max-width:950px}header{text-align:center;background:#164F5D;color:#fff;padding:15px 12px;margin-bottom:14px}header h1{font-size:19px;margin:4px 0}header h2{font-size:14px;margin:0}header .subtitle{color:#e8f1f3;margin-top:6px}.folio{font-size:11px;margin-top:4px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#d8e2e4;border:1px solid #d8e2e4;margin-bottom:16px}.meta div{background:#f3f7f8;padding:7px 9px;min-height:31px}.meta b{display:inline-block;min-width:108px}.rubro{margin:13px 0 5px;background:#e8f1f3;color:#164F5D;padding:6px 8px;font-size:13px}.rub-table{width:100%;border-collapse:collapse;margin:0 0 13px}.rub-table th{background:#176F82;color:#fff;padding:6px;text-align:left}.rub-table td{border-bottom:1px solid #d9dfe0;padding:6px;vertical-align:top}.rub-table th:first-child,.rub-table td:first-child{text-align:center;width:8%}.rub-table .num{text-align:right;white-space:nowrap;width:17%}.rub-table tfoot th{background:#f3f7f8;color:#222;text-align:right;border-top:1px solid #b8c5c7}.rub-table tfoot th:last-child{text-align:right}.totales{margin:14px 0 0 auto;width:390px;border-collapse:collapse}.totales td{padding:6px 9px;border-bottom:1px solid #e3e7e8}.totales td:last-child{text-align:right;white-space:nowrap}.totales .total{background:#164F5D;color:#fff;font-weight:bold}.totales .insured{font-weight:bold;border-top:2px solid #164F5D}.totales .carrier{background:#e8f1f3;color:#164F5D;font-weight:bold}.nota{margin-top:18px;font-size:10px;color:#667}.print-btn{margin:0 0 12px}@@media print{.print-btn{display:none}body{margin:10mm;max-width:none}.rub-table tr{break-inside:avoid}header{print-color-adjust:exact;-webkit-print-color-adjust:exact}.rub-table th,.rubro,.totales .total,.totales .carrier{print-color-adjust:exact;-webkit-print-color-adjust:exact}}
</style></head><body>
<header><h2>HOSPITAL EL QUETZAL, S.A.</h2><h1>ESTADO DE CUENTA HOSPITALARIO</h1><div class="subtitle">@if(emergencia){<text>ATENCIÓN DE EMERGENCIA</text>}else if(!string.IsNullOrWhiteSpace(atencion)){@atencion}</div><div class="folio">Cuenta @v.Folio</div></header>
<div class="meta"><div><b>Paciente</b>@(Model.Paciente is null ? "—" : $"{Model.Paciente.Nombre} {Model.Paciente.Apellido}")</div><div><b>Fecha de atención</b>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</div><div><b>Aseguradora</b>@(Model.Aseguradora?.Nombre ?? "—")</div><div><b>Servicio</b>@(atencion ?? "—")</div><div><b>Póliza / Certificado</b>@(v.PolizaCertificado ?? "—")</div><div><b>Autorización</b>@(v.Autorizacion ?? "—")</div></div>
@foreach(var categoria in Model.Categorias){<h3 class="rubro">@categoria.Nombre.ToUpperInvariant()</h3><table class="rub-table"><thead><tr><th>Cant.</th><th>Descripción</th><th class="num">Precio unitario</th><th class="num">Subtotal</th></tr></thead><tbody>@foreach(var d in categoria.Detalles){<tr><td>@d.Cantidad.ToString("0.##")</td><td>@d.Descripcion</td><td class="num">Q @d.PrecioUnitario.ToString("N2")</td><td class="num">Q @d.Subtotal.ToString("N2")</td></tr>}</tbody><tfoot><tr><th colspan="3">Subtotal @categoria.Nombre.ToLowerInvariant()</th><th class="num">Q @categoria.Subtotal.ToString("N2")</th></tr></tfoot></table>}
<table class="totales"><tbody><tr class="total"><td>TOTAL ESTADO DE CUENTA</td><td>Q @Model.Total.ToString("N2")</td></tr><tr><td>Copago</td><td>Q @v.Copago.ToString("N2")</td></tr><tr><td>Coaseguro @v.CoaseguroPorc.ToString("N2")%</td><td>Q @Model.CoaseguroMonto.ToString("N2")</td></tr><tr class="insured"><td>TOTAL A CARGO DEL ASEGURADO</td><td>Q @Model.TotalAsegurado.ToString("N2")</td></tr><tr class="carrier"><td>VALOR A CARGO DE @((Model.Aseguradora?.Nombre ?? "ASEGURADORA").ToUpperInvariant())</td><td>Q @Model.TotalAseguradora.ToString("N2")</td></tr></tbody></table><div class="nota">Descripciones y tarifas según configuración vigente para el hospital y la aseguradora.</div>
<script>
    window.addEventListener('load', () => {
        const abrirImpresion = () => requestAnimationFrame(() => requestAnimationFrame(() => window.print()));
        if (document.fonts?.ready) document.fonts.ready.then(abrirImpresion); else abrirImpresion();
    });
</script>
</body></html>
