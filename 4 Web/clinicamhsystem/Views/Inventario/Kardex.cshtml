@model List<ClinicaDomain.MovimientoInventario>
@{
    ViewData["Title"] = "Kardex";
    var producto = (ClinicaDomain.Producto)ViewBag.Producto;
    var lotes = (List<ClinicaDomain.LoteProducto>)ViewBag.Lotes;
}
<div class="card shadow-lg mt-4">
    <div class="card-header d-flex justify-content-between">
        <h5>Kardex - @producto.Nombre (stock: @producto.StockActual)</h5>
        <a href="@Url.Action("Index","Inventario")" class="btn btn-outline-secondary btn-sm">Volver</a>
    </div>
    <div class="card-body">
        @if (producto.RequiereLote)
        {
            <h6>Lotes disponibles</h6>
            <table class="table table-sm"><thead><tr><th>Lote</th><th>Vence</th><th>Stock</th><th>Costo</th></tr></thead>
            <tbody>@foreach (var l in lotes){<tr><td>@l.CodigoLote</td><td>@l.FechaVencimiento?.ToString("d")</td><td>@l.Stock</td><td>@l.CostoUnitario</td></tr>}</tbody></table>
        }
        <h6 class="mt-3">Movimientos</h6>
        <table class="table table-sm table-striped">
            <thead class="table-dark"><tr><th>Fecha</th><th>Tipo</th><th>Cantidad</th><th>Costo</th><th>Motivo</th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr><td>@m.Fecha.ToString("g")</td><td>@m.Tipo</td><td>@m.Cantidad</td><td>@m.CostoUnitario</td><td>@m.Motivo</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
