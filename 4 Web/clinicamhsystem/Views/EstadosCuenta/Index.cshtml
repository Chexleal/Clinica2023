@model List<ClinicaDomain.Venta>
@{
    ViewData["Title"] = "Estados de cuenta hospitalarios";
    var pacientes = (IEnumerable<ClinicaDomain.Paciente>)(ViewBag.Pacientes ?? System.Linq.Enumerable.Empty<ClinicaDomain.Paciente>());
    var aseguradoras = (IEnumerable<ClinicaDomain.Aseguradora>)(ViewBag.Aseguradoras ?? System.Linq.Enumerable.Empty<ClinicaDomain.Aseguradora>());
    var nombres = (Dictionary<Guid, string>)(ViewBag.PacienteNombres ?? new Dictionary<Guid, string>());
}
<div class="card shadow-lg p-3 mb-4 mt-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="fa-solid fa-file-invoice-dollar" style="color:#2d8f77"></i> Estados de cuenta hospitalarios</h4>
    </div>
    <div class="card-body">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger py-2">@TempData["Error"]</div>
        }
        <form method="get" class="row g-2 mb-3">
            <div class="col-2"><label class="fw-bold small">Desde</label><input type="date" name="desde" value="@ViewBag.Desde" class="form-control form-control-sm" /></div>
            <div class="col-2"><label class="fw-bold small">Hasta</label><input type="date" name="hasta" value="@ViewBag.Hasta" class="form-control form-control-sm" /></div>
            <div class="col-3">
                <label class="fw-bold small">Paciente</label>
                <select name="idPaciente" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var p in pacientes)
                    {
                        @if (ViewBag.IdPaciente is Guid selPac && selPac == p.IdPaciente)
                        {
                            <option value="@p.IdPaciente" selected>@p.Nombre @p.Apellido</option>
                        }
                        else
                        {
                            <option value="@p.IdPaciente">@p.Nombre @p.Apellido</option>
                        }
                    }
                </select>
            </div>
            <div class="col-3">
                <label class="fw-bold small">Aseguradora</label>
                <select name="idAseguradora" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var a in aseguradoras)
                    {
                        @if (ViewBag.IdAseguradora is Guid selAse && selAse == a.IdAseguradora)
                        {
                            <option value="@a.IdAseguradora" selected>@a.Nombre</option>
                        }
                        else
                        {
                            <option value="@a.IdAseguradora">@a.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="col-2"><label class="fw-bold small">Autorización</label><input name="autorizacion" value="@ViewBag.Autorizacion" class="form-control form-control-sm" /></div>
            <div class="col-12 col-md-auto align-self-end"><button class="btn btn-dark btn-sm">Filtrar</button></div>
        </form>

        <hr class="mt-1 mb-3" />
        <div class="table-responsive">
            <table class="table table-sm table-hover tabla-config" data-search-placeholder="Buscar cuenta" data-export-name="EstadosCuenta">
                <thead class="table-dark"><tr><th>Fecha</th><th>Folio</th><th>Paciente</th><th>Autorización</th><th class="text-end">Total</th><th></th></tr></thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td class="text-nowrap">@v.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@v.Folio</td>
                            <td>@(v.IdPaciente.HasValue && nombres.TryGetValue(v.IdPaciente.Value, out var nombre) ? nombre : "—")</td>
                            <td>@v.Autorizacion</td>
                            <td class="text-end fw-bold">Q @v.Total.ToString("N2")</td>
                            <td class="text-nowrap text-end">
                                <a class="btn btn-sm btn-outline-primary" target="_blank" href="@Url.Action("Ver", new { id = v.IdVenta })">Ver / Imprimir</a>
                                <partial name="_AuditInfo" model="v" />
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted">Sin resultados para los filtros.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_DataTablesButtonsScripts" />
    <script src="~/js/pages/audit-info.js" asp-append-version="true"></script>
    <script src="~/js/pages/tablas-config.js" asp-append-version="true"></script>
}
