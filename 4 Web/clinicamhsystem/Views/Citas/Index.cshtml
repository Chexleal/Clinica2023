@model clinicaWeb.Models.CitasViewModel;
@{
    ViewData["Title"] = "Citas";
}
@section Links{
    <link rel="stylesheet" href="~/css/pages/calendario.css" asp-append-version="true" />
}

<div class="card w-100 shadow-lg mt-4" id="citas">

    <div class="card-header bg-light">
        <h3 class="titulo">Citas</h3>
    </div>
    <div class="card-body">
        @await Html.PartialAsync("_calendar", Model)
</div>
</div>

@section Scripts{
    <script src="~/js/pages/calendario.js" asp-append-version="true"></script>
        }
