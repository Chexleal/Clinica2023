@model ConsultaContinuarViewModel
@using ClinicaDomain
@using Newtonsoft.Json
@using ClinicaInfrastructure
@{
    ViewData["Title"] = "Continuar Consultas";
}
@section Links{
    <link rel="stylesheet" href="~/css/pages/calendario.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/dicom-viewer.css" asp-append-version="true" />
}

<partial name="Partials/_historialTabla.cshtml" />
<partial name="Partials/_modalReceta.cshtml" />

<form id="formCST" method="post" action="@Url.Action("Guardar")">
    <input hidden name="IdConsulta" value="@Model.Consulta.IdConsulta" />
    <div class="card shadow-lg p-3 mb-5">
        <div class="card-header bg-white">
            <h3>@Model.Consulta.PacienteInformacion.Nombre @Model.Consulta.PacienteInformacion.Apellido</h3>
        </div>
        <div class="card-body align-content-center">


            <div class="row mt-4 ">
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold">Genero: </label> <label>@Model.Consulta.PacienteInformacion.Genero</label>
                </div>
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold">Edad: </label> <label>@DateManager.GetAge(Model.Consulta.PacienteInformacion.FechaNacimiento) </label>
                </div>
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold">Alergias: </label> <label>@Model.Consulta.PacienteInformacion.Alergias</label>
                </div>

            </div>
            <div class="row mt-4">

                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold d-inline">Peso: </label> <input class="form-control d-inline" name="Peso" value="@Model.Consulta.Peso" />
                </div>
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold">Presión Arterial: </label> <input class="form-control" name="PresionArterial" value="@Model.Consulta.PresionArterial">
                </div>
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold">Temperatura: </label> <input class="form-control" name="Temperatura" value="@Model.Consulta.Temperatura">
                </div>
            </div>
            <div class="row mt-4">
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold">Saturación de Oxígeno: </label> <input class="form-control" name="SaturacionOxigeno" value="@Model.Consulta.SaturacionOxigeno">
                </div>
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold">Glucómetro: </label> <input class="form-control" name="Glucometro" value="@Model.Consulta.Glucometro">
                </div>
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold">Frecuencia Cardíaca: </label> <input class="form-control" name="FrecuenciaCardiaca" value="@Model.Consulta.FrecuenciaCardiaca">
                </div>
            </div>
            <div class="row mt-4">
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold" for="antecedentes">Antecedentes: </label>
                    <textarea class="form-control" id="antecedentes" name="antecedentes" rows="1" maxlength="1000" style="resize:vertical">@Model.Consulta.PacienteInformacion.Antecedentes</textarea>
                </div>
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold">Motivo Consulta: </label> <input class="form-control" name="MotivoConsulta" value="@Model.Consulta.MotivoConsulta">
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-lg p-3 mb-5 mt-5">
        <div class="card-header bg-white">
            @{
                var consultas = new List<Consulta>(Model.Consulta.PacienteInformacion.Consulta.Where(x=>x.Terminada).OrderByDescending(x => x.Fecha).ToList());
                // Almacenar el PacienteInformacion de cada objeto de consultas en una lista
                var pacientesInformacion = consultas.Select(c => c.PacienteInformacion).ToList();
                // Asignar null a la propiedad PacienteInformacion de cada objeto de consultas
                consultas.ForEach(c => c.PacienteInformacion = null);
                // Serializar la lista de consultas modificada
                var historiaJson = JsonConvert.SerializeObject(consultas);
                // Asignar el PacienteInformacion correspondiente a cada objeto de consultas
                consultas.Zip(pacientesInformacion, (c, p) => new { Consulta = c, PacienteInformacion = p })
                .ToList()
                .ForEach(cp => cp.Consulta.PacienteInformacion = cp.PacienteInformacion);

            }
            <button type="button" id="btnHistorialConsulta.PacienteInformacion" onclick="ShowHistorialModal(@historiaJson)" class="btn btn-mini" title="Historial Paciente">
                <i class="fa-solid fa-clock-rotate-left fa-bounce fa-xl" style="color: #2d8f77;"></i>
                <p style="color: #2d8f77; font-weight: bold;">Historial</p>
            </button>

            <button type="button" id="btnReceta" onclick="ShowReceta('@Model.Receta.IdReceta')" class="btn btn-mini" title="Receta">
                <i class="fa-solid fa-file-signature fa-bounce fa-xl" style="color: #2d8f77;"></i>
                <p style="color: #2d8f77; font-weight: bold;">Receta</p>
            </button>
            <button type="button" id="btnCalendario" onclick="ShowCalendario('@Model.Consulta.IdPaciente')" class="btn btn-mini" title="Historia">
                <i class="fa-solid fa-calendar fa-bounce fa-xl" style="color: #2d8f77;"></i>
                <p style="color: #2d8f77; font-weight: bold;">Calendario</p>
            </button>
            <button type="button" id="btnEstudios" onclick="ShowEstudios()" class="btn btn-mini" title="Estudios del paciente">
                <i class="fa-solid fa-x-ray fa-bounce fa-xl" style="color: #2d8f77;"></i>
                <p style="color: #2d8f77; font-weight: bold;">Estudios</p>
            </button>
            <button type="button" id="btnOrdenes" onclick="ShowOrdenes()" class="btn btn-mini" title="Ordenes de estudio">
                <i class="fa-solid fa-file-circle-plus fa-bounce fa-xl" style="color: #2d8f77;"></i>
                <p style="color: #2d8f77; font-weight: bold;">Ordenes</p>
            </button>
        </div>
        <div class="card-body">
            <div class="row mt-2">
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold" for="observaciones">Historia clínica: </label>
                    <textarea class="form-control" id="observaciones" name="HistoriaClinica">@Model.Consulta.HistoriaClinica</textarea>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold" for="diagnostico">Diagnóstico: </label>
                    <textarea class="form-control" id="diagnostico" name="Diagnostico">@Model.Consulta.Diagnostico</textarea>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold" for="diagnostico">CIE-10: </label>
                    <textarea class="form-control" id="diagnostico" name="Diagnostico">@Model.Consulta.Diagnostico</textarea>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <label class="fw-bold" for="diagnostico">Observaciones: </label>
                    <textarea class="form-control" id="diagnostico" name="Observaciones">@Model.Consulta.Observaciones</textarea>
                </div>
            </div>

            <div class="row mt-5">
                <div class="col col-sm col-md col-lg col-xl col-xxl">
                    <input hidden id="terminado" name="Terminada" value="@Model.Consulta.IdPaciente" />
                    @if (!Model.Consulta.Terminada)
                    {
                       @* <button type="submit" id="btnGuardar" class="btn btn-outline-dark mb-3" onclick="guardadoAlert()">Guardar Cambios</button>*@
                        <button type="submit" class="btn btn-outline-dark mb-3" onclick="guardadoAlert(event)">Guardar Cambios</button>
                        @*<button type="submit" id="btnTerminar" class="btn btn-dark mb-3">Terminar Consulta</button>*@
                        <button type="submit" class="btn btn-dark mb-3" onclick="alertTerminarConsulta(event)">Terminar Consulta</button>
                    }
                </div>
            </div>
        </div>

    </div>
</form>

<!-- ===== ÁREA ÓRDENES + CARGA ESTUDIOS (ruta, peso, quien) ===== -->
@{
    var idPaciente = Model.Consulta.IdPaciente;
    var idConsulta = Model.Consulta.IdConsulta;
    var estudios = ViewBag.Estudios as List<ClinicaDomain.EstudioImagen> ?? new();
    var ordenes = ViewBag.Ordenes as List<ClinicaDomain.OrdenEstudio> ?? new();
}







    <!-- Visor DICOM .dcm - Fase 1: local | Fase 2: Azure Blob -->
    <div class="card shadow-lg p-3 mb-5 mt-4" id="cardRadiografias">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0"><i class="fa-solid fa-x-ray" style="color:#2d8f77"></i> Radiografías DICOM <small class="text-muted" style="font-size:13px;">(.dcm)</small></h5>
            <span class="badge bg-secondary dcm-badge-wl" id="dcmStatus">Sin archivo</span>
        </div>
        <div class="card-body">
            <div class="row mb-3 align-items-end">
                <div class="col-12">
                    <label class="fw-bold" for="dcmFileInput">Cargar archivo .dcm (local):</label>
                    <input type="file" id="dcmFileInput" accept=".dcm,application/dicom" class="form-control" />
                </div>
                
            </div>

            <div id="dicomViewerContainer">
                <div class="btn-group flex-wrap" role="group" id="dcmToolbar" style="display:none">
                    <button type="button" class="btn btn-outline-light btn-sm" data-tool="WindowLevel" title="Brillo/Contraste: arrastra con mouse"><i class="fa-solid fa-circle-half-stroke"></i> WW/WL</button>
                    <button type="button" class="btn btn-outline-light btn-sm" data-tool="Zoom" title="Zoom: arrastra vertical o rueda"><i class="fa-solid fa-magnifying-glass"></i> Zoom</button>
                    <button type="button" class="btn btn-outline-light btn-sm" data-tool="Pan" title="Mover imagen"><i class="fa-solid fa-arrows-up-down-left-right"></i> Pan</button>
                    <button type="button" class="btn btn-outline-light btn-sm" id="btnDcmLength" title="Medir distancia: clic en 2 puntos (mm si el DICOM trae PixelSpacing)"><i class="fa-solid fa-ruler"></i> Regla</button>
                    <button type="button" class="btn btn-outline-light btn-sm" id="btnDcmReset" title="Restaurar vista"><i class="fa-solid fa-rotate-left"></i> Reset</button>
                    <button type="button" class="btn btn-outline-light btn-sm" id="btnDcmInvert" title="Invertir colores"><i class="fa-solid fa-adjust"></i> Invert</button>
                    <button type="button" class="btn btn-outline-light btn-sm" id="btnDcmRotL" title="Rotar -90"><i class="fa-solid fa-rotate-left"></i></button>
                    <button type="button" class="btn btn-outline-light btn-sm" id="btnDcmRotR" title="Rotar +90"><i class="fa-solid fa-rotate-right"></i></button>
                    <button type="button" class="btn btn-outline-light btn-sm" id="btnDcmClear" title="Borrar mediciones"><i class="fa-solid fa-eraser"></i></button>
                    <button type="button" class="btn btn-outline-light btn-sm" id="btnDcmFullscreen" title="Pantalla completa"><i class="fa-solid fa-expand"></i></button>
                </div>
                <div id="dicomImage"></div>
                <div id="dicomOverlay"></div>
                <div id="dcmWlPanel" style="display:none">
                    <div class="dcm-wl-row"><label>Contraste (WW) <b id="dcmWwVal"></b> <small id="dcmWwPct"></small></label><input id="dcmWwRange" type="range" min="1" max="4000" step="1"></div>
                    <div class="dcm-wl-row"><label>Brillo (WL) <b id="dcmWlVal"></b> <small id="dcmWlPct"></small></label><input id="dcmWlRange" type="range" min="-1000" max="3000" step="1"></div>
                </div>
                <div id="dicomInfo"></div>
            </div>

            <div id="dcmPlaceholder" class="text-center py-5 px-3">
                <i class="fa-solid fa-file-medical fa-3x" style="color:#8bc2f2"></i>
                <p class="mt-3 mb-1 text-muted">Selecciona un archivo <b>.dcm</b> para visualizarlo aquí.</p>
                <small class="text-muted">También puedes arrastrar y soltar el archivo sobre esta zona. Rueda = zoom, arrastre = WW/WL o Pan según herramienta.</small>
            </div>

            <div id="dcmTags" class="row mt-3" style="display:none">
                <div class="col-12">
                    <small class="fw-bold"><i class="fa-solid fa-tags"></i> Tags DICOM:</small>
                    <small id="dcmTagsContent" class="font-monospace text-muted"></small>
                </div>
            </div>
            <small class="text-muted d-block mt-2"><i class="fa-solid fa-circle-info"></i> Si la imagen se ve negra, prueba ajustar WW/WL arrastrando o pulsa Reset. Algunos .dcm comprimidos JPEG2000 requieren codecs adicionales (se agregarán en fase 2).</small>
        </div>
    </div>



<div class="modal fade" id="modalEstudios" tabindex="-1" role="dialog" aria-labelledby="modalEstudios" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-x-ray" style="color:#2d8f77"></i> Estudios del paciente <small class="text-muted" style="font-size:13px;">solo visualizacion</small></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="contEstudiosModal">
                    <partial name="Partials/_estudiosLista" model="estudios" />
                </div>
                <small class="text-muted d-block mt-2"><i class="fa-solid fa-circle-info"></i> La carga de archivos la realiza Archivo en el area de <b>Estudios</b>.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalOrdenes" tabindex="-1" role="dialog" aria-labelledby="modalOrdenes" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-file-circle-plus" style="color:#2d8f77"></i> Ordenes de Estudio <small class="text-muted" style="font-size:13px;">genera Rx / MR / Lab</small></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formCrearOrden" class="row g-2 align-items-end">
                    <input type="hidden" name="idPaciente" value="@idPaciente" />
                    <input type="hidden" name="idConsulta" value="@idConsulta" />
                    <div class="col-12 col-md-2">
                        <label class="fw-bold small">Tipo</label>
                        <select name="tipo" id="ordenTipo" class="form-select form-select-sm" required>
                            <option value="1">Rx</option>
                            <option value="2">Panoramica</option>
                            <option value="3">Cefalometrica</option>
                            <option value="4">Tomografia</option>
                            <option value="5">Resonancia</option>
                            <option value="6">Ultrasonido</option>
                            <option value="7">Laboratorio</option>
                            <option value="99">Otro</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="fw-bold small">Catalogo (por tipo)</label>
                        <select id="ordenCatalogo" class="form-select form-select-sm">
                            <option value="">-- Selecciona indicacion --</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="fw-bold small">Indicacion</label>
                        <input name="indicacion" id="ordenIndicacion" class="form-control form-control-sm" placeholder="Se llena desde catalogo o escribe Otra..." maxlength="500" required />
                    </div>
                    <div class="col-12 col-md-2">
                        <button type="submit" class="btn btn-dark btn-sm w-100"><i class="fa-solid fa-plus"></i> Generar orden</button>
                    </div>
                </form>
                <hr class="my-3" />
                <div id="contOrdenes">
                    <partial name="Partials/_ordenesTabla" model="ordenes" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCalendario" tabindex="-1" role="dialog" aria-labelledby="modalCalendario" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="height:100%; width:100%;">
            </div>
        </div>
    </div>
</div>







@section Scripts{
    <!-- DICOM Viewer deps (Cornerstone) - jsDelivr más estable que unpkg -->
    <script src="https://cdn.jsdelivr.net/npm/cornerstone-core@2.6.1/dist/cornerstone.min.js" onerror="console.error('Fallo cornerstone-core CDN')"></script>
    <script src="https://cdn.jsdelivr.net/npm/dicom-parser@1.8.21/dist/dicomParser.min.js" onerror="console.error('Fallo dicomParser CDN')"></script>
    <script src="https://cdn.jsdelivr.net/npm/cornerstone-math@0.1.10/dist/cornerstoneMath.min.js" onerror="console.error('Fallo cornerstoneMath CDN')"></script>
    <script src="https://cdn.jsdelivr.net/npm/hammerjs@2.0.8/hammer.min.js" onerror="console.error('Fallo hammer CDN')"></script>
    <script src="https://cdn.jsdelivr.net/npm/cornerstone-tools@6/dist/cornerstoneTools.min.js" onerror="console.error('Fallo cornerstoneTools CDN')"></script>
    <script src="https://cdn.jsdelivr.net/npm/cornerstone-wado-image-loader@4.13.2/dist/cornerstoneWADOImageLoader.bundle.min.js" onerror="console.error('Fallo WADO loader CDN')"></script>
    <script src="~/js/pages/continuar-consultas.js" asp-append-version="true"></script>
    <script src="~/js/pages/dicom-viewer.js" asp-append-version="true"></script>
    <script src="~/js/pages/estudios-ordenes.js" asp-append-version="true"></script>
    <script>

        function alertTerminarConsulta(e) {
            e.preventDefault();
            Swal.fire({
                title: '¿Esta seguro de terminar esta consulta?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Si',
                cancelButtonText: 'No'
            }).then((result) => {
                if (result.isConfirmed) {
                    const formulario = document.getElementById('formCST');
                    $("#terminado").val(true);
                    formulario.submit();
                }
            })
        }

        function guardadoAlert(e) {
            e.preventDefault();
            Swal.fire({
                icon: 'success',
                title: 'Cambios guardados',
                showConfirmButton: false,
                timer: 1500
            }).then(() => {
                const formulario = document.getElementById('formCST');
                formulario.submit();
            })
        }

        var state = "@Model.Consulta.Terminada";

        var urlReceta="@Url.Action("DescargarPdf","ContinuarConsulta")?consultaId=";
        var urlGetMedicamentos = "@Url.Action("GetMedicamentos","ContinuarConsulta")";
        var urlSaveReceta = "@Url.Action("GuardarReceta","ContinuarConsulta")";
        if(state=='True'){
           
            SetReadOnly();
        }
       
        // Catálogo indicaciones por tipo
        var catalogoData = @Html.Raw(ViewBag.CatalogoJson ?? "[]");
        function filtrarCatalogo(){
            const tipo = parseInt($('#ordenTipo').val());
            const $cat = $('#ordenCatalogo');
            $cat.empty().append('<option value="">-- Selecciona indicación --</option>');
            const filtrados = catalogoData.filter(c=> c.Tipo===tipo && c.Activo);
            filtrados.forEach(c=> $cat.append(`<option value="${c.Descripcion}">${c.Descripcion}${c.Codigo ? ' ('+c.Codigo+')' : ''}</option>`));
            $cat.append('<option value="__otra">Otra (escribir)...</option>');
            $cat.trigger('change');
            $('#ordenIndicacion').val('');
        }
        $('#ordenTipo').on('change', filtrarCatalogo);
        $('#ordenCatalogo').on('change', function(){
            const v = $(this).val();
            if(v==='__otra'){ $('#ordenIndicacion').val('').focus().attr('placeholder','Escribe indicación específica...'); }
            else if(v){ $('#ordenIndicacion').val(v); }
        });
        filtrarCatalogo();

        // Select2 con buscador dentro de la modal de ordenes
        $('#ordenTipo').select2({ dropdownParent: $('#modalOrdenes'), width: '100%' });
        $('#ordenCatalogo').select2({ dropdownParent: $('#modalOrdenes'), width: '100%', placeholder: 'Busca una indicacion...' });

        // Estudios en modal (a la par del icono Calendario)
        function ShowEstudios(){
            var pid = '@Model.Consulta.IdPaciente';
            $.get('/ContinuarConsulta/GetEstudios', { idPaciente: pid }, function(html){
                $('#contEstudiosModal').html(html);
            }).fail(function(){
                $('#contEstudiosModal').html('<div class="alert alert-warning">No se pudieron cargar los estudios.</div>');
            });
            $('#modalEstudios').modal('show');
        }

        // Ordenes en modal (icono propio)
        function ShowOrdenes(){
            var pid = '@Model.Consulta.IdPaciente';
            $.get('/ContinuarConsulta/GetOrdenes', { idPaciente: pid }, function(html){
                $('#contOrdenes').html(html);
            }).fail(function(){
                $('#contOrdenes').html('<div class="alert alert-warning">No se pudieron cargar las ordenes.</div>');
            });
            $('#modalOrdenes').modal('show');
        }
        $(document).on('click', '.btn-del-orden', function(){
            var idOrden = $(this).data('id');
            var pid = $('#formCrearOrden input[name="idPaciente"]').val();
            Swal.fire({ title: 'Eliminar orden?', text: 'Solo se puede eliminar si esta pendiente.', icon: 'warning', showCancelButton: true, confirmButtonText: 'Si, eliminar' }).then(function(r){
                if(!r.isConfirmed) return;
                $.post('/ContinuarConsulta/DeleteOrden', { idOrden: idOrden, idPaciente: pid }, function(html){
                    $('#contOrdenes').html(html);
                    Swal.fire({ icon: 'success', title: 'Orden eliminada', timer: 1200, showConfirmButton: false });
                }).fail(function(){ Swal.fire({ icon: 'error', title: 'No se pudo eliminar' }); });
            });
        });
        $(document).on('click', '#contEstudiosModal .btn-ver-dicom', function(){
            $('#modalEstudios').modal('hide');
        });

    </script>
}
