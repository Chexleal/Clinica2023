@{
    ViewData["Title"] = "Configuraciones";
}
<div class="card shadow-lg p-3 mb-4">
    <div class="card-header bg-white">
        <h4><i class="fa-solid fa-gear" style="color:#2d8f77"></i> Configuraciones <small class="text-muted" style="font-size:14px">mantenimiento de catálogos</small></h4>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="card h-100 border">
                    <div class="card-body d-flex flex-column">
                        <h5><i class="fa-solid fa-list" style="color:#2d8f77"></i> Indicaciones de estudios</h5>
                        <p class="text-muted small">Catálogo por tipo (Rx, Tomografía, Resonancia, etc.) usado en ContinuarConsulta al generar órdenes. <span class="badge bg-secondary">@ViewBag.TotalIndicaciones</span></p>
                        <div class="mt-auto d-flex gap-2">
                            <a href="@Url.Action("Catalogo","Estudios")" class="btn btn-dark btn-sm"><i class="fa-solid fa-pen-to-square"></i> Administrar</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card h-100 border">
                    <div class="card-body d-flex flex-column">
                        <h5><i class="fa-solid fa-hand-holding-medical" style="color:#2d8f77"></i> Servicios</h5>
                        <p class="text-muted small">Motivos de cobro usados en Consultas / Pagos / Reportes. <span class="badge bg-secondary">@ViewBag.TotalServicios</span></p>
                        <div class="mt-auto d-flex gap-2">
                            <a href="@Url.Action("Index","Servicios")" class="btn btn-dark btn-sm"><i class="fa-solid fa-pen-to-square"></i> Administrar</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card h-100 border">
                    <div class="card-body d-flex flex-column">
                        <h5><i class="fa-solid fa-pills" style="color:#2d8f77"></i> Medicamentos</h5>
                        <p class="text-muted small">Catálogo usado en la receta de ContinuarConsulta (antes solo se auto-creaba). <span class="badge bg-secondary">@ViewBag.TotalMedicamentos</span></p>
                        <div class="mt-auto d-flex gap-2">
                            <a href="@Url.Action("Medicamentos","Configuraciones")" class="btn btn-dark btn-sm"><i class="fa-solid fa-pen-to-square"></i> Administrar</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
