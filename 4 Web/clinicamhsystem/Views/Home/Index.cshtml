@{
   Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Inicio - Traumha</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/limonte-sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
</head>
<body>
    <div class="container vh-100 d-flex justify-content-center align-items-center">
        <div class="mb-md-1 mt-md-1">
            <div class="mx-auto my-auto">
                <form id="loginForm" onclick="" action="@Url.Action("LogIn")" method="post" class="form text-center">
                    <div class="logo">
                        <img src="~/img/NewLogoOp-nav.png" alt="Logo" style="width:80%" class="mb-3">
                    </div>
                    <input type="text" id="user" class="mb-3" placeholder="Usuario" name="user" />
                    <input type="password" id="password" class="mb-3" placeholder="Contraseña" name="password" />
                    <a class="forgot mb-4" href="@Url.Action("RecuperarCuenta")">¿Olvidó su contraseña?</a>
                    <button type="submit">Entrar</button>
                </form>
            </div>
        </div>
    </div>

    <div id="sweetAlertContainer"></div>
    <div id="errorMessage" style="display:none;">@TempData["Error"]</div>
    <div id="successMessage" style="display:none;">@TempData["Success"]</div>

    <script src="~/lib/limonte-sweetalert2/sweetalert2.min.js"></script>
    @if (TempData["Error"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
    {
        <script>
            Swal.fire({
                title: 'Error',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage)),
                icon: 'error',
                confirmButtonText: 'Aceptar'
            });
        </script>
    }
    @if (TempData["Success"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
    {
        <script>
            Swal.fire({
                title: 'Éxito',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage)),
                icon: 'success',
                confirmButtonText: 'Aceptar'
            });
        </script>
    }

</body>
</html>
