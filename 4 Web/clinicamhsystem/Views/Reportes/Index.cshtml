                                            var subG = g.Sum(x => x.Subtotal);
                                            var unoSolo = g.Count() == 1;
                                            <tr class="micro-n2-head @(gi % 2 == 1 ? "micro-fecha-a" : "micro-fecha-b")">
                                                <td><button type="button" class="btn-micro-n2 btn btn-sm btn-outline-secondary" title="Ver movimientos del día">@(unoSolo ? "−" : "+")</button></td>
                                                <td class="fw-bold">@g.Key.ToString("dd/MM/yyyy")</td>
                                                <td>@g.Count()</td>
                                                <td>@cantG</td>
                                                <td>Q @subG</td>
                                            </tr>
                                            <tr class="micro-n2-det" style="@(unoSolo ? "" : "display:none;")">
                                                <td></td>
                                                <td colspan="4" class="p-1">
                                                    <table class="table table-sm table-bordered mb-0 micro-n2-table">
                                                        <thead class="table-light">
                                                            <tr><th>Paciente</th><th>Origen</th><th>Tipo pago</th><th>Cantidad</th><th>Subtotal</th></tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var m in g.OrderBy(x => x.Paciente).ThenBy(x => x.Origen))
                                                            {
                                                                <tr>
                                                                    <td>@m.Paciente</td>
                                                                    <td>@m.Origen</td>
                                                                    <td><span class="badge bg-light text-dark border">@m.MetodoPago</span></td>
                                                                    <td>@m.Cantidad</td>
                                                                    <td>Q @m.Subtotal</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    @foreach (var kvd in microDiaStore)
                    {
                        var gruposServ = kvd.Value.GroupBy(x => x.Servicio).OrderBy(g => g.Key).ToList();
                        <div id="@kvd.Key">
