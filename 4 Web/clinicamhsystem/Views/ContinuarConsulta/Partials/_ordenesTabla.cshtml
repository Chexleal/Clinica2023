@model List<ClinicaDomain.OrdenEstudio>
@using ClinicaDomain
@if (Model == null || !Model.Any())
{
    <div class="text-muted small py-2"><i class="fa-solid fa-inbox"></i> Sin órdenes</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Fecha</th><th>Tipo</th><th>Indicación</th><th>Estado</th><th></th></tr></thead>
            <tbody>
            @foreach (var o in Model.OrderByDescending(x=>x.FechaOrden))
            {
                <tr data-id="@o.IdOrden" data-tipo="@((int)o.Tipo)">
                    <td><small>@o.FechaOrden.ToString("dd/MM/yyyy")</small></td>
                    <td><span class="badge bg-info">@o.Tipo</span> @if(o.EsExterna){<span class="badge bg-dark" title="Examen externo: se imprime para el paciente">Ext</span>}</td>
                    <td><small>@o.Indicacion</small></td>
                    <td>
                        @if(o.Estado==EstadoOrden.Pendiente){<span class="badge bg-warning text-dark">Pendiente</span>}
                        else if(o.Estado==EstadoOrden.Completada){<span class="badge bg-success">Completada</span>}
                        else if(o.Estado==EstadoOrden.Impresa){<span class="badge bg-primary">Impresa</span>}
                        else{<span class="badge bg-secondary">@o.Estado</span>}
                    </td>
                    <td class="text-end text-nowrap">
                        <a href="@Url.Action("ImprimirOrden","ContinuarConsulta", new{ idOrden=o.IdOrden })" target="_blank" class="btn btn-sm btn-outline-secondary" title="Imprimir orden"><i class="fa-solid fa-print"></i></a>
                        @if(o.Estado==EstadoOrden.Pendiente){<button type="button" class="btn btn-sm btn-outline-danger btn-del-orden" data-id="@o.IdOrden" title="Eliminar orden"><i class="fa-solid fa-trash"></i></button>}
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
