@model clinicaWeb.Models.ServiciosViewModel;

@{
    ViewData["Title"] = "Catálogo Servicios";
}
<div class="card shadow-lg p-3 mb-4">

    <div class="card-header bg-white d-flex align-items-center gap-2">
        <a href="@Url.Action("Index","Configuraciones")" class="btn btn-outline-secondary btn-sm" title="Volver a Configuraciones"><i class="fa-solid fa-arrow-left"></i></a>
        <h4 class="mb-0"><i class="fa-solid fa-hand-holding-medical" style="color:#2d8f77"></i> Catálogo Servicios</h4>
    </div>

    <div class="card-body">
        <form method="POST" action="@Url.Action("Create","Servicios")" class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-8">
                <label class="fw-bold small">Servicio</label>
                <input required name="Descripcion" id="Descripcion" class="form-control form-control-sm" style="text-transform:uppercase;" placeholder="Ej: Consulta general" maxlength="300" />
            </div>
            <div class="col-12 col-md-2">
                <label class="fw-bold small">Precio sugerido</label>
                <input name="PrecioSugerido" id="PrecioSugerido" type="number" step="0.01" min="0" class="form-control form-control-sm" placeholder="0.00" />
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-dark btn-sm w-100"><i class="fa-solid fa-plus"></i> Agregar</button>
            </div>
        </form>
        <hr class="mt-1 mb-3" />
        <div class="table-responsive ">
            <table id="table" class="table table-sm table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Servicio</th>
                        <th>Precio sugerido</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Servicios)
                    {
                        <tr>
                            <td>@item.Descripcion</td>
                            <td>Q@(item.PrecioSugerido.ToString("0.00"))</td>
                            <td class="text-end text-nowrap">
                                <partial name="_AuditInfo" model="item" />
                                <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#editar-@item.IdMotivoCobro" title="Editar"><i class="fa-solid fa-pen"></i></button>
                                <button class="btn btn-sm btn-outline-danger" type="button" onclick="alertElminarPrevents('@item.IdMotivoCobro')"><i class="fa-solid fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @foreach (var item in Model.Servicios)
        {
            <div class="modal fade" id="editar-@item.IdMotivoCobro" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <form method="post" action="@Url.Action("Actualizar","Servicios")">
                        <div class="modal-content">
                            <div class="modal-header"><h6 class="mb-0">Editar servicio</h6><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                            <div class="modal-body row g-2 text-start">
                                <input type="hidden" name="id" value="@item.IdMotivoCobro" />
                                <div class="col-12"><label class="small fw-bold">Servicio</label><input required name="descripcion" value="@item.Descripcion" class="form-control form-control-sm" style="text-transform:uppercase;" maxlength="300" /></div>
                                <div class="col-12 col-md-6"><label class="small fw-bold">Precio sugerido</label><input name="precioSugerido" value="@item.PrecioSugerido.ToString("0.00")" type="number" step="0.01" min="0" class="form-control form-control-sm" /></div>
                            </div>
                            <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary btn-sm">Guardar</button></div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>


@section Scripts{
    <script>

        function alertElminarPrevents(id) {
            Swal.fire({
                title: '¿Esta seguro de eliminar este servicio?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Si',
                cancelButtonText: 'No'
            }).then((resultado) => {

                if (resultado.isConfirmed) {
                    $.ajax({
                        url: '/Servicios/Eliminar',
                        type: 'POST',
                        data: {id : id},
                        success: function (result) {
successWithTimer('/Servicios/Index')
                        },
                        error: function (error) {
                            console.log(error);
                        }
                    });
                    //successWithTimer('eliminarForm');
                }

            })
        }
    </script>
    <partial name="_DataTablesButtonsScripts" />
    <script src="~/js/pages/audit-info.js" asp-append-version="true"></script>
    <script src="~/js/pages/servicios.js" asp-append-version="true"></script>
}