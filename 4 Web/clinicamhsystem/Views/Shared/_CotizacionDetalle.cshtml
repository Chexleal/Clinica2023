@model clinicamhsystem.Models.CotizacionEditorViewModel

@{
    // Diseño espejo de cobro (_CobroDetalle) para cotizaciones: mismo sistema de
    // agregar Servicio/Producto/Otro, sin pagos y sin movimientos de inventario.
    var cot = Model.Cotizacion;
    var editable = Model.Editable;
    var lineas = Model.Detalles ?? new List<ClinicaDomain.CotizacionDetalle>();
    var subServicios = lineas.Where(x => x.TipoLinea == "Servicio").Sum(x => x.Subtotal);
    var subProductos = lineas.Where(x => x.TipoLinea == "Producto").Sum(x => x.Subtotal);
    var totalDesc = lineas.Sum(x => x.DescuentoMonto);
    var bruto = subServicios + subProductos + totalDesc;
    var total = subServicios + subProductos;
    string fmt(decimal v) => v.ToString("0.00");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var primerPrecioProd = (Model.Productos?.FirstOrDefault()?.PrecioVenta ?? 0) > 0
        ? Model.Productos!.First().PrecioVenta.ToString("0.00", inv) : "";
}

<style>
    /* select2 a la misma altura exacta que form-control-sm / form-select-sm (31px) */
    .cot-root .select2-container { display: block !important; }
    .cot-root .select2-container--default .select2-selection--single {
        height: 31px !important;
        min-height: 31px !important;
        border: 1px solid var(--bs-border-color, #dee2e6) !important;
        border-radius: .25rem !important;
        font-size: .875rem !important;
    }
    .cot-root .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 29px !important;
        font-size: .875rem !important;
        padding-left: .5rem !important;
        padding-right: 1.5rem !important;
    }
    .cot-root .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 29px !important;
        right: .25rem !important;
    }
    .cot-root .select2-dropdown { font-size: .875rem !important; }
</style>

<div class="cot-root">
    @if (editable)
    {
    <!-- Formulario de ingreso -->
    <ul class="nav nav-pills justify-content-start mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button type="button" id="seg-agregar-servicio" class="nav-link bg-light text-dark fw-bold" onclick="setTipoAgregar('servicio')">Servicio</button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" id="seg-agregar-producto" class="nav-link text-muted" onclick="setTipoAgregar('producto')">Producto</button>
        </li>
        <li class="nav-item" role="presentation">
            <button type="button" id="seg-agregar-express" class="nav-link text-muted" onclick="setTipoAgregar('express')">Otro</button>
        </li>
    </ul>

    <datalist id="motivosDescuento">
        <option value="Cortesía"></option>
        <option value="Convenio"></option>
        <option value="Error de precio"></option>
        <option value="Promoción"></option>
        <option value="Paciente frecuente"></option>
        <option value="Otro"></option>
    </datalist>
    <div id="panel-agregar-servicio" class="border rounded-3 p-3 bg-light-subtle">
        <form id="agregarDetalleForm" method="POST">
            <input hidden name="id" value="@cot?.IdCotizacion" />
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="small fw-bold" for="idMotivoCobro">Servicio</label>
                    <select class="form-select form-select-sm select2" id="idMotivoCobro" name="idMotivoCobro" style="width:100%;">
                        @foreach (var opcion in (Model.Servicios ?? new List<ClinicaDomain.MotivoCobro>()))
                        {
                            <option value="@opcion.IdMotivoCobro" data-precio="@opcion.PrecioSugerido.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">@opcion.Descripcion (Q@(fmt(opcion.PrecioSugerido)))</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="small fw-bold" for="ProductoDesc">Detalle</label>
                    <input name="descripcion" id="ProductoDesc" class="form-control form-control-sm" placeholder="Opcional" />
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold" for="ValorServicio">Valor</label>
                    <input name="precio" id="ValorServicio" class="form-control form-control-sm" />
                </div>
                <div class="col-md-1">
                    <label class="small fw-bold">Cant.</label>
                    <input name="cantidad" class="form-control form-control-sm" value="1" />
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-primary btn-sm w-100" type="button" onclick="addDetalle()"><i class="fa-solid fa-plus"></i></button>
                </div>
            </div>
        </form>
    </div>

    <div id="panel-agregar-producto" class="border rounded-3 p-3 bg-light-subtle" style="display:none;">
        <form id="agregarProductoForm" method="POST">
            <input hidden name="id" value="@cot?.IdCotizacion" />
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="small fw-bold" for="idProducto">Producto de inventario</label>
                        <select class="form-select form-select-sm select2" id="idProducto" name="idProducto" style="width:100%;">
                        @foreach (var p in (Model.Productos ?? new List<ClinicaDomain.Producto>()))
                        {
                            <option value="@p.IdProducto" data-precio="@p.PrecioVenta.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">@p.Nombre - Q@(fmt(p.PrecioVenta)) (stock: @p.StockActual)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="small fw-bold" for="ProductoDetalle">Detalle</label>
                    <input name="descripcion" id="ProductoDetalle" class="form-control form-control-sm" placeholder="Opcional" />
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold" for="ValorProducto">Valor</label>
                    <input name="precio" id="ValorProducto" class="form-control form-control-sm" value="@primerPrecioProd" />
                </div>
                <div class="col-md-1">
                    <label class="small fw-bold">Cant.</label>
                    <input name="cantidad" class="form-control form-control-sm" value="1" />
                </div>
                <div class="col-md-1">
                    <label class="small fw-bold" for="EsPedidoProd">Pedido</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="esSobrePedido" value="true" id="EsPedidoProd" title="Sobre pedido: referencia sin stock" />
                        <label class="form-check-label small" for="EsPedidoProd">S/ped.</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-primary btn-sm w-100" type="button" onclick="addProducto()"><i class="fa-solid fa-plus"></i></button>
                </div>
            </div>
        </form>
        <small class="text-muted">Referencial: la cotización no valida stock ni reserva nada (se valida al convertir a venta).</small>
    </div>

    <div id="panel-agregar-express" class="border-0" style="display:none;">
        <div class="btn-group btn-group-sm mb-2" role="group" aria-label="Tipo de concepto nuevo">
            <button type="button" id="seg-expres-producto" class="btn btn-outline-secondary active" onclick="setTipoExpress('producto')">Producto nuevo</button>
            <button type="button" id="seg-expres-servicio" class="btn btn-outline-secondary" onclick="setTipoExpress('servicio')">Servicio nuevo</button>
        </div>
        <div id="panel-expres-producto">
        <form id="productoExpressForm" method="POST">
            <input hidden name="id" value="@cot?.IdCotizacion" />
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="small fw-bold">Nombre del producto nuevo</label>
                    <input name="nombre" class="form-control form-control-sm" placeholder="Ej: Plantilla talla M" required />
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold">Precio venta</label>
                    <input name="precio" type="number" step="0.01" min="0" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold">Cantidad</label>
                    <input name="cantidad" type="number" step="0.01" min="0.01" value="1" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold">Costo</label>
                    <input name="costo" type="number" step="0.01" min="0" class="form-control form-control-sm" placeholder="—" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-primary btn-sm w-100" type="button" onclick="addProductoExpress()"><i class="fa-solid fa-plus me-1"></i>Agregar</button>
                </div>
            </div>
        </form>
        <small class="text-muted">Crea el producto en catálogo (sin entrada de inventario) y lo suma a esta cotización.</small>
        </div>
        <div id="panel-expres-servicio" style="display:none;">
        <form id="servicioExpressForm" method="POST">
            <input hidden name="id" value="@cot?.IdCotizacion" />
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="small fw-bold">Descripción del servicio nuevo</label>
                    <input name="descripcion" class="form-control form-control-sm" placeholder="Ej: Curación especial" required />
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold">Valor</label>
                    <input name="precio" type="number" step="0.01" min="0" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-2">
                    <label class="small fw-bold">Cantidad</label>
                    <input name="cantidad" type="number" step="0.01" min="0.01" value="1" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-primary btn-sm w-100" type="button" onclick="addServicioExpress()"><i class="fa-solid fa-plus me-1"></i>Agregar</button>
                </div>
            </div>
        </form>
        <small class="text-muted">Crea el servicio en el catálogo y lo suma a esta cotización.</small>
        </div>
    </div>

    <hr class="my-4" />
    }

    <!-- Ítems del listado -->
    <div class="small fw-bold text-muted text-uppercase mt-1 mb-2">Cotización actual (@lineas.Count)</div>
    <ul class="list-group list-group-flush">
        @if (!lineas.Any())
        {
            <li class="list-group-item border-0 text-center text-muted small py-3">
                La cotización está vacía. Agrega el primer concepto arriba.
            </li>
        }
        @foreach (var item in lineas)
        {
            var esProducto = item.TipoLinea == "Producto";
            var tieneDesc = item.DescuentoMonto > 0;
            var quienDesc = item.DescuentoOtorgadoPorNombre;
            <li class="list-group-item border-0 border-bottom d-flex align-items-center py-3">
                <div class="bg-light rounded p-2 me-3">
                    <i class="fa-solid @(esProducto ? "fa-box-open" : "fa-stethoscope")"></i>
                </div>
                <div>
                    <div class="fw-bold">
                        @item.Descripcion
                        <span class="badge @(esProducto ? "bg-secondary" : "bg-light text-secondary border") ms-2">@item.TipoLinea</span>
                        @if (esProducto && item.EsSobrePedido)
                        {
                            <span class="badge bg-info ms-1">sobre pedido</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                    <small class="text-muted">
                        @if (esProducto || item.Cantidad != 1)
                        {
                            <span>Cantidad: @item.Cantidad × Q@(fmt(item.PrecioUnitario))</span>
                        }
                        else
                        {
                            <span>Precio unitario Q@(fmt(item.PrecioUnitario))</span>
                        }
                        @if (tieneDesc)
                        {
                            <span> · desc. Q@(fmt(item.DescuentoMonto)) (@item.DescuentoMotivo@(string.IsNullOrWhiteSpace(quienDesc) ? "" : " · por " + quienDesc))</span>
                        }
                    </small>
                    @if (editable)
                    {
                        @if (!tieneDesc)
                        {
                            <button class="btn btn-outline-success py-0 px-1 lh-sm" style="font-size:.7rem;" type="button"
                                    title="Aplicar descuento" data-bs-toggle="collapse" data-bs-target="#desc-@item.IdCotizacionDetalle">
                                <i class="fa-solid fa-tag me-1"></i>Aplicar descuento
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-success py-0 px-1 lh-sm" style="font-size:.7rem;" type="button"
                                    title="Editar descuento" data-bs-toggle="collapse" data-bs-target="#desc-@item.IdCotizacionDetalle">
                                <i class="fa-solid fa-pen me-1"></i>Editar
                            </button>
                        }
                    }
                    </div>
                    @if (editable)
                    {
                        <div class="collapse mt-2" id="desc-@item.IdCotizacionDetalle">
                            <div class="d-flex gap-2 align-items-end">
                                <div>
                                    <label class="small fw-bold">Desc. Q</label>
                                    <input id="descMonto-@item.IdCotizacionDetalle" type="number" step="0.01" min="0" value="@item.DescuentoMonto.ToString("0.00", inv)" class="form-control form-control-sm" style="width:100px;" />
                                </div>
                                <div>
                                    <label class="small fw-bold">Motivo</label>
                                    <input id="descMotivo-@item.IdCotizacionDetalle" list="motivosDescuento" value="@item.DescuentoMotivo" class="form-control form-control-sm" style="width:170px;" placeholder="Cortesía, convenio..." />
                                </div>
                                <button class="btn btn-sm btn-success" type="button" onclick="aplicarDescuento('@item.IdCotizacionDetalle')">Guardar</button>
                            </div>
                        </div>
                    }
                </div>
                <div class="ms-auto text-end">
                    <div class="fw-bold">Q@(fmt(item.Subtotal))</div>
                    @if (tieneDesc)
                    {
                        <div><span class="badge bg-success" title="@(string.IsNullOrWhiteSpace(item.DescuentoMotivo) ? "Descuento" : item.DescuentoMotivo)@(string.IsNullOrWhiteSpace(quienDesc) ? "" : " · por " + quienDesc)">-Q@(fmt(item.DescuentoMonto))</span></div>
                    }
                    @if (editable)
                    {
                        <div class="mt-1 d-flex justify-content-end gap-2">
                        <button class="btn btn-link text-danger p-0" type="button"
                                title="Quitar concepto" onclick="deleteCotizacionDetalle('@item.IdCotizacionDetalle')">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                        </div>
                    }
                </div>
            </li>
        }
    </ul>
    <input hidden id="IdCotizacionRef" value="@cot?.IdCotizacion" />

    <!-- Totales -->
    <div class="bg-light rounded p-3 mt-3">
        <div class="d-flex justify-content-between small mb-1">
            <span class="text-muted">Bruto (sin descuentos)</span>
            <span>Q@(fmt(bruto))</span>
        </div>
        <div class="d-flex justify-content-between small mb-1">
            <span class="text-muted">Subtotal servicios</span>
            <span>Q@(fmt(subServicios))</span>
        </div>
        <div class="d-flex justify-content-between small mb-1">
            <span class="text-muted">Subtotal productos</span>
            <span>Q@(fmt(subProductos))</span>
        </div>
        @if (totalDesc > 0)
        {
            <div class="d-flex justify-content-between small mb-2 text-success">
                <span>Total descuentos</span>
                <span>-Q@(fmt(totalDesc))</span>
            </div>
        }
        <div class="d-flex justify-content-between align-items-baseline">
            <span class="fw-bold">Total cotizado</span>
            <span class="fw-bold fs-4">Q@(fmt(total))</span>
        </div>
    </div>

    <!-- Pie / acciones -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-3 border-top">
        <small class="text-muted">
            <i class="fa-solid fa-circle-info me-1"></i>La cotización no reserva ni descuenta inventario.
        </small>
        <div class="d-flex gap-2 ms-auto">
            @if (editable)
            {
                @if (cot?.Estado == "Borrador")
                {
                    <form asp-action="Emitir" asp-controller="Cotizaciones" asp-route-id="@cot?.IdCotizacion" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-success" type="submit">Emitir (vigente @cot?.VigenciaDias días)</button>
                    </form>
                }
                <form asp-action="Convertir" asp-controller="Cotizaciones" asp-route-id="@cot?.IdCotizacion" method="post" class="m-0" onsubmit="return confirm('¿Convertir a venta de mostrador? Se validará el stock actual.');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-primary" type="submit" @(lineas.Any() ? "" : "disabled")>Convertir a venta</button>
                </form>
                <form asp-action="Rechazar" asp-controller="Cotizaciones" asp-route-id="@cot?.IdCotizacion" method="post" class="m-0" onsubmit="return confirm('¿Marcar como rechazada?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-secondary" type="submit">Rechazar</button>
                </form>
                <form asp-action="Anular" asp-controller="Cotizaciones" asp-route-id="@cot?.IdCotizacion" method="post" class="m-0" onsubmit="return confirm('¿Anular la cotización?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-danger" type="submit">Anular</button>
                </form>
            }
            else
            {
                <small class="text-muted align-self-center">Cotización cerrada (@cot?.Estado) — solo lectura.</small>
            }
        </div>
    </div>
</div>
