@model List<ClinicaDomain.OrdenEstudio>
@using ClinicaDomain
@if (Model == null || !Model.Any())
{
    <p class="text-muted small mb-0">Sin órdenes externas pendientes para esta consulta.</p>
}
else
{
    <p class="small text-muted">Seleccione la orden a imprimir. Cada una se abre en su hoja individual.</p>
    <div class="list-group">
        @foreach (var o in Model)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="badge bg-info">@o.Tipo</span>
                    @if (o.Estado == EstadoOrden.Impresa)
                    {<span class="badge bg-primary">Impresa, por entregar</span>}
                    else
                    {<span class="badge bg-warning text-dark">Por imprimir</span>}
                    <div class="small mt-1">@o.FechaOrden.ToString("dd/MM/yyyy") · @o.Indicacion</div>
                </div>
                <a href="@Url.Action("ImprimirOrden", "Estudios", new { idOrden = o.IdOrden })" target="_blank" class="btn btn-sm btn-dark"><i class="fa-solid fa-print"></i> Imprimir</a>
            </div>
        }
    </div>
}
