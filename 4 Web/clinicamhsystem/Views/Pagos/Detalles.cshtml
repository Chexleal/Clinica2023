@model DetallesPagarViewModel

@{
    ViewData["Title"] = "Pagar Consulta";
    var venta = Model.Venta;
}

<!-- Cabecera unificada -->
<div class="modal-header border-bottom">
    <h5 class="modal-title" id="exampleModalLabel">Pagar Consulta <span class="badge bg-secondary ms-2">@venta?.Folio</span></h5>
    <div class="ms-auto d-flex align-items-center">
        <button class="btn btn-outline-primary btn-sm me-2" type="button" onclick="guardarTemporal()"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar temporal</button>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
</div>

<div class="modal-body">
    <p class="small text-muted mb-3">
        @ViewBag.PacienteNombre
        <span class="mx-1">·</span> Atención: @ViewBag.AtencionFecha
    </p>
    @{
        var ordenesExt = ViewBag.OrdenesExternas as List<ClinicaDomain.OrdenEstudio> ?? new();
        var tieneNota = (ViewBag.TieneNotaMedica as bool?) ?? false;
    }
    @if (tieneNota && Model.consulta is not null)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div><i class="fa-solid fa-file-medical"></i> <b>Esta consulta tiene nota médica:</b> imprímala y entréguela antes de que se retire.</div>
            <a href="@Url.Action("ImprimirNotaMedica", "Pagos", new { idconsulta = Model.consulta.IdConsulta })" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-print"></i> Imprimir nota</a>
        </div>
    }
    @if (ordenesExt.Any())
    {
        <div class="alert alert-warning d-flex flex-column gap-2 mb-3">
            <div><i class="fa-solid fa-print"></i> <b>Este paciente tiene @ordenesExt.Count orden(es) externa(s):</b> imprima y entréguela(s) antes de que se retire.</div>
            @foreach (var o in ordenesExt)
            {
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-top pt-2">
                    <span class="small">@o.FechaOrden.ToString("dd/MM/yyyy") · <b>@o.Tipo</b> · @o.Indicacion
                        @if (o.Estado == ClinicaDomain.EstadoOrden.Impresa)
                        {<span class="badge bg-primary ms-1">Impresa, por entregar</span>}
                        else
                        {<span class="badge bg-warning text-dark ms-1">Por imprimir</span>}
                    </span>
                    <a href="@Url.Action("ImprimirOrden", "Estudios", new { idOrden = o.IdOrden })" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-print"></i> Imprimir</a>
                </div>
            }
        </div>
    }
    <form id="coberturaFormConsulta" class="border rounded p-2 mb-3">
        <input type="hidden" name="idVenta" value="@venta?.IdVenta" />
        <input type="hidden" name="idConsulta" value="@Model.consulta?.IdConsulta" />
        <div class="row g-2 mb-2"><div class="col-md-4"><label class="form-label" for="tipoAtencionConsulta">Tipo de atención</label><select id="tipoAtencionConsulta" name="tipoAtencion" class="form-select form-select-sm"><option value="Normal" selected="@(venta?.TipoAtencion != ClinicaDomain.TipoAtencion.Emergencia)">Normal</option><option value="Emergencia" selected="@(venta?.TipoAtencion == ClinicaDomain.TipoAtencion.Emergencia)">Emergencia</option></select></div></div>
        <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="usaAseguradoraConsulta" checked="@(venta?.IdAseguradora != null)" /><label class="form-check-label" for="usaAseguradoraConsulta">Cuenta aseguradora</label></div>
        <div id="coberturaConsulta" class="row g-2">
            <div class="col-md-4"><label class="form-label">Aseguradora</label><select id="aseguradoraConsulta" name="idAseguradora" class="form-select form-select-sm"><option value="">Seleccione...</option>@foreach(var a in (IEnumerable<ClinicaDomain.Aseguradora>)(ViewBag.Aseguradoras ?? new List<ClinicaDomain.Aseguradora>())){<option value="@a.IdAseguradora" data-copago="@a.CopagoDefault" data-coaseguro="@a.CoaseguroPorcDefault" selected="@(venta?.IdAseguradora==a.IdAseguradora)">@a.Nombre (@a.IdentificadorFiscal)</option>}</select></div>
            <div class="col-md-2"><label class="form-label">Copago</label><input name="copago" id="copagoConsulta" type="number" min="0" step=".01" value="@(venta?.Copago??0)" class="form-control form-control-sm" /></div>
            <div class="col-md-2"><label class="form-label">Coaseguro %</label><input name="coaseguroPorc" id="coaseguroConsulta" type="number" min="0" max="100" step=".01" value="@(venta?.CoaseguroPorc??0)" class="form-control form-control-sm" /></div>
            <div class="col-md-4"><label class="form-label">Póliza / Certificado</label><input name="polizaCertificado" value="@venta?.PolizaCertificado" class="form-control form-control-sm" /></div>
            <div class="col-md-4"><label class="form-label">Autorización</label><input name="autorizacion" value="@venta?.Autorizacion" class="form-control form-control-sm" /></div>
            <div class="col-md-4"><label class="form-label">Servicio de atención</label><input name="servicioAtencion" value="@venta?.ServicioAtencion" class="form-control form-control-sm" /></div>
        </div><a class="btn btn-outline-secondary btn-sm mt-2" target="_blank" href="@Url.Action("Ver","EstadosCuenta",new{id=venta?.IdVenta})"><i class="fa-solid fa-print me-1"></i>Imprimir</a>
    </form>
    <partial name="_CobroDetalle" model="Model" />
</div>

