@model PagarConsultaViewModel

@{
    ViewData["Title"] = "Pagos";
}

@section Links{
    <link rel="stylesheet" href="~/css/pages/Consultas.css" asp-append-version="true" />
}

<div class="card w-100 shadow-lg mt-5">
    <div class="card-header bg-ligth">
        <h3 class="h3">Pagar Consultas</h3>
    </div>
    <div class="card-body">
        <div class=" table-responsive ">
            <table id="table" class="table table-striped ">
                <thead class="table-dark">
                    <tr>
                        <th></th>
                        <th>Acciones</th>
                        <th>Fecha de creación</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Motivo de consulta</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var extPorConsulta = ViewBag.ExternasPorConsulta as Dictionary<Guid, List<ClinicaDomain.OrdenEstudio>> ?? new();
                        var notasPorConsulta = ViewBag.NotasPorConsulta as HashSet<Guid> ?? new();
                    }
                    @foreach (var item in Model.Consultas)
                    {
                        <tr>
                            <td><partial name="_AuditPopover" model="item" /></td>
                            <td>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <button class="btn-detalles btn btn-primary btn-sm" data-id="@item.IdConsulta" title="Cobrar consulta">Pagar</button>
                                    <button class="btn-ver-consulta btn btn-outline-info btn-sm" data-id="@item.IdConsulta" title="Ver consulta en modo lectura"><i class="fa-solid fa-eye"></i> Ver</button>
                                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("DescargarPdf","ContinuarConsulta",new{consultaId=item.IdConsulta})" target="_blank" title="Imprimir receta"><i class="fa-solid fa-file-prescription"></i> Receta</a>
                                    @if (extPorConsulta.TryGetValue(item.IdConsulta, out var ordenesExt) && ordenesExt.Count > 0)
                                    {
                                        <button class="btn btn-sm btn-ordenes btn-ver-ordenes" data-id="@item.IdConsulta" title="Ver órdenes externas de esta consulta"><i class="fa-solid fa-print"></i> Órdenes (@ordenesExt.Count)</button>
                                    }
                                    @if (notasPorConsulta.Contains(item.IdConsulta))
                                    {
                                        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("ImprimirNotaMedica", "Pagos", new { idconsulta = item.IdConsulta })" target="_blank" title="Imprimir nota médica"><i class="fa-solid fa-file-medical"></i> Nota</a>
                                    }
                                </div>
                            </td>
                            <td>@DateManager.GetDisplayDate(item.FechaCreacion, item.Fecha).ToString("dd/MM/yyyy", System.Globalization.CultureInfo.GetCultureInfo("es-GT"))</td>
                            <td>@item.PacienteInformacion.Nombre</td>
                            <td>@item.PacienteInformacion.Apellido</td>
                            <td>@item.MotivoConsulta</td>          
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Modal Pagar Consulta (cabecera/cuerpo/pie los renderiza Pagos/Detalles) -->
<div class="modal fade" id="pagarConsultaModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
        </div>
    </div>
</div>


<!-- Panel lateral de solo lectura (offcanvas derecha) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="verConsultaCanvas" aria-labelledby="verConsultaTitulo" style="width:min(520px,100vw);">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="verConsultaTitulo"><i class="fa-solid fa-eye" style="color:#2d8f77"></i> Consulta <span class="badge bg-secondary">Solo lectura</span></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body" id="verConsultaBody">
    </div>
</div>

<!-- Modal órdenes externas (impresión individual) -->
<div class="modal fade" id="ordenesExternasModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title"><i class="fa-solid fa-print" style="color:#2d8f77"></i> Órdenes externas</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="ordenesExternasBody">
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_DataTablesButtonsScripts" />
    <script src="~/js/pages/audit-info.js" asp-append-version="true"></script>
    <script src="~/js/pages/pagos.js" asp-append-version="true"></script>
    <script>
        // Modal "Órdenes": lista las externas de la consulta para imprimir una por una
        $(document).on('click', '.btn-ver-ordenes', function () {
            var id = $(this).data('id');
            $('#ordenesExternasBody').html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>');
            bootstrap.Modal.getOrCreateInstance('#ordenesExternasModal').show();
            $.get('@Url.Action("OrdenesExternas","Pagos")', { idconsulta: id })
                .done(function (html) { $('#ordenesExternasBody').html(html); })
                .fail(function () { $('#ordenesExternasBody').html('<div class="alert alert-warning">No se pudieron cargar las órdenes.</div>'); });
        });
    </script>
    <script>
        // Panel lateral "Ver": carga el parcial de solo lectura sin salir de Pagos
        $(document).on('click', '.btn-ver-consulta', function () {
            var id = $(this).data('id');
            $('#verConsultaBody').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="text-muted small mt-2">Cargando consulta...</p></div>');
            bootstrap.Offcanvas.getOrCreateInstance('#verConsultaCanvas').show();
            $.get('@Url.Action("VerConsulta","Pagos")', { idconsulta: id })
                .done(function (html) { $('#verConsultaBody').html(html); })
                .fail(function () { $('#verConsultaBody').html('<div class="alert alert-warning">No se pudo cargar la consulta.</div>'); });
        });
    </script>
}
