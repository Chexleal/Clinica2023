@{
    ViewData["Title"] = "God Mode · Usuarios";
    var usuarios = (List<ClinicaDomain.Usuario>)(ViewBag.Usuarios ?? new List<ClinicaDomain.Usuario>());
    var clinicas = (List<ClinicaDomain.Clinica>)(ViewBag.Clinicas ?? new List<ClinicaDomain.Clinica>());
}
@section Links {
    <style>
        .god-card { border: 0; border-radius: 1rem; box-shadow: 0 .25rem 1rem rgba(16,24,40,.08); }
        .god-card .card-header { background: transparent; border-bottom: 1px solid #eef1f6; font-weight: 700; }
    </style>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">God Mode</a></li>
        <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
    </ol>
</nav>

<h2><i class="fa-solid fa-users-gear me-2"></i>Usuarios y accesos por clínica</h2>
<p class="text-muted">El login es global; el acceso a cada clínica se asigna aquí. Los permisos (Citas, Consultas…) son los mismos en todas sus clínicas.</p>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert"><i class="fa-solid fa-circle-check me-1"></i>@ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}

<div class="card god-card">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-users me-1"></i>@usuarios.Count usuarios</span>
        <span class="text-muted fw-normal small">Clínicas activas: @string.Join(" · ", clinicas.Select(c => c.Nombre))</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Usuario</th><th>Nombre</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                @foreach (var u in usuarios)
                {
                    <tr>
                        <td class="fw-semibold">@u.NombreUsuario</td>
                        <td>@u.Nombre @u.Apellido</td>
                        <td>
                            @if (u.UsuarioActivo) { <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success">Activo</span> }
                            else { <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary">Inactivo</span> }
                        </td>
                        <td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="Accesos" asp-route-id="@u.IdUsuario"><i class="fa-solid fa-key me-1"></i>Accesos</a></td>
                    </tr>
                }
                @if (!usuarios.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Sin usuarios.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
