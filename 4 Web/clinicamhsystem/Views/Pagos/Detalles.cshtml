@model DetallesPagarViewModel

@{
    ViewData["Title"] = "Pagar Consulta";
    var venta = Model.Venta;
}

<!-- Cabecera unificada -->
<div class="modal-header border-bottom">
    <h5 class="modal-title" id="exampleModalLabel">Pagar Consulta <span class="badge bg-secondary ms-2">@venta?.Folio</span></h5>
    <div class="ms-auto d-flex align-items-center">
        <button class="btn btn-outline-primary btn-sm me-2" type="button" data-bs-dismiss="modal" onclick="guardarTemporal()"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar temporal</button>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
</div>

<div class="modal-body">
    <p class="small text-muted mb-3">
        @ViewBag.PacienteNombre
        <span class="mx-1">·</span> Atención: @ViewBag.AtencionFecha
    </p>
    @{
        var ordenesExt = ViewBag.OrdenesExternas as List<ClinicaDomain.OrdenEstudio> ?? new();
        var tieneNota = (ViewBag.TieneNotaMedica as bool?) ?? false;
    }
    @if (tieneNota && Model.consulta is not null)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div><i class="fa-solid fa-file-medical"></i> <b>Esta consulta tiene nota médica:</b> imprímala y entréguela antes de que se retire.</div>
            <a href="@Url.Action("ImprimirNotaMedica", "Pagos", new { idconsulta = Model.consulta.IdConsulta })" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-print"></i> Imprimir nota</a>
        </div>
    }
    @if (ordenesExt.Any())
    {
        <div class="alert alert-warning d-flex flex-column gap-2 mb-3">
            <div><i class="fa-solid fa-print"></i> <b>Este paciente tiene @ordenesExt.Count orden(es) externa(s):</b> imprima y entréguela(s) antes de que se retire.</div>
            @foreach (var o in ordenesExt)
            {
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-top pt-2">
                    <span class="small">@o.FechaOrden.ToString("dd/MM/yyyy") · <b>@o.Tipo</b> · @o.Indicacion
                        @if (o.Estado == ClinicaDomain.EstadoOrden.Impresa)
                        {<span class="badge bg-primary ms-1">Impresa, por entregar</span>}
                        else
                        {<span class="badge bg-warning text-dark ms-1">Por imprimir</span>}
                    </span>
                    <a href="@Url.Action("ImprimirOrden", "Estudios", new { idOrden = o.IdOrden })" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-print"></i> Imprimir</a>
                </div>
            }
        </div>
    }
    <partial name="_CobroDetalle" model="Model" />
</div>

@section Scripts{
    <script src="~/js/pages/pagos.js" asp-append-version="true"></script>
}
