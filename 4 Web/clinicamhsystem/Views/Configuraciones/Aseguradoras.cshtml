@model List<ClinicaDomain.Aseguradora>
@{ ViewData["Title"]="Aseguradoras"; }
<div class="card shadow-lg mt-4"><div class="card-header"><h4>Aseguradoras</h4></div><div class="card-body">
@if(TempData["Error"] is string e){<div class="alert alert-warning">@e</div>}
<form method="post" asp-action="GuardarAseguradora" class="row g-2 mb-3"><div class="col"><label>Nombre</label><input name="nombre" class="form-control" required /></div><div class="col"><label>Identificador fiscal</label><input name="identificadorFiscal" class="form-control" /></div><div class="col"><label>Contacto</label><input name="contacto" class="form-control" /></div><div class="col"><label>Copago default</label><input name="copagoDefault" type="number" step=".01" min="0" value="0" class="form-control" /></div><div class="col"><label>Coaseguro %</label><input name="coaseguroPorcDefault" type="number" step=".01" min="0" max="100" value="0" class="form-control" /></div><div class="col-auto align-self-end"><button class="btn btn-primary">Agregar</button></div></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Nombre</th><th>Identificador fiscal</th><th>Contacto</th><th>Copago</th><th>Coaseguro</th><th>Activa</th><th></th><th>Tarifas</th></tr></thead><tbody>
@foreach(var a in Model){var formId=$"aseguradora-{a.IdAseguradora}";<tr><td><input form="@formId" name="nombre" value="@a.Nombre" required class="form-control form-control-sm"/></td><td><input form="@formId" name="identificadorFiscal" value="@a.IdentificadorFiscal" class="form-control form-control-sm"/></td><td><input form="@formId" name="contacto" value="@a.Contacto" class="form-control form-control-sm"/></td><td><input form="@formId" name="copagoDefault" value="@a.CopagoDefault.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" type="number" step=".01" min="0" class="form-control form-control-sm"/></td><td><input form="@formId" name="coaseguroPorcDefault" value="@a.CoaseguroPorcDefault.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" type="number" step=".01" min="0" max="100" class="form-control form-control-sm"/></td><td><input form="@formId" type="checkbox" name="activa" value="true" checked="@a.Activa"/><input form="@formId" type="hidden" name="activa" value="false"/></td><td><form id="@formId" method="post" asp-action="GuardarAseguradora"><input type="hidden" name="id" value="@a.IdAseguradora"/><button class="btn btn-sm btn-outline-primary">Guardar</button></form></td><td><a class="btn btn-sm btn-outline-secondary" href="@Url.Action("TarifasAseguradora",new{idAseguradora=a.IdAseguradora})">Ver / editar</a></td></tr>}
</tbody></table></div></div></div>
