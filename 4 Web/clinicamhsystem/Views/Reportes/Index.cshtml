@using ClinicaDomain;
@using Newtonsoft.Json;
@model clinicaWeb.Models.ReportesViewModel;

@{
    ViewData["Title"] = "Reportes";
}
@section Links{
    <link rel="stylesheet" href="~/css/pages/Reportes.css" asp-append-version="true" />
}

<div class="card w-100 shadow-lg mt-5">
    <div class="card-body">
        <!-- Tabs -->

        @{
            // Primera pestaña: Por Servicios. Segunda: Por Paciente.
            // Activa Paciente tras buscar un paciente o todos los del rango.
            var mostrarPaciente = Model.Paciente != null || Model.VerTodosPacientes;
        }
        <ul class="nav nav-tabs" id="myTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(!mostrarPaciente ? "active" : "")" id="tab-servicios-tab" data-bs-toggle="tab" data-bs-target="#tab-servicios" type="button" role="tab" aria-controls="tab-servicios" aria-selected="@(!mostrarPaciente ? "true" : "false")">Por Concepto</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(mostrarPaciente ? "active" : "")" id="tab-paciente-tab" data-bs-toggle="tab" data-bs-target="#tab-paciente" type="button" role="tab" aria-controls="tab-paciente" aria-selected="@(mostrarPaciente ? "true" : "false")">Por Paciente</button>
            </li>
        </ul>

        <!-- Contenido de los tabs -->
        <div class="tab-content" id="myTabsContent">
            <div class="tab-pane fade @(!mostrarPaciente ? "show active" : "")" id="tab-servicios" role="tabpanel" aria-labelledby="tab-servicios-tab">
                <form id="servicios-search" method="POST" action="@Url.Action("Servicios","Reportes")">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Del</label>
                                <input required class="form-control" type="date" name="from_dt" id="from_servicios" value="@(Model.From == default(DateTime) ? "" : Model.From.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                <label class="control-label">Al</label>
                                <input required class="form-control" type="date" name="to_dt" id="to_servicios" value="@(Model.To == default(DateTime) ? "" : Model.To.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>
                        @{
                            var tipoSel = ((ViewBag.TipoFiltro as string) ?? Model.TipoFiltro ?? "todos").ToLower();
                        }
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">Tipo</label>
                                <select name="tipo" id="tipo_reporte" class="form-control">
                                    <option value="todos" selected="@(tipoSel == "todos" ? "selected" : null)">Todos (servicios + productos)</option>
                                    <option value="servicios" selected="@(tipoSel == "servicios" ? "selected" : null)">Solo servicios</option>
                                    <option value="productos" selected="@(tipoSel == "productos" ? "selected" : null)">Solo productos</option>
                                </select>
                            </div>
                        </div>
                        @*<div class="col-md-3">
                        <div class="form-group">
                        <label class="control-label">Servicio</label>
                        <select name="IdPaciente" class="form-control">
                        <option></option>
                        @foreach (var servicio in Model.Servicios)
                        {
                        <option value="@servicio.IdMotivoCobro">@servicio.Descripcion</option>
                        }
                        </select>
                        </div>
                        </div>*@
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">&nbsp;</label>
                                <div class="d-flex align-items-center gap-2 mt-2">
                                    <input type="checkbox" id="chkSinIngresos" style="width:18px;height:18px;accent-color:#0077c0;" @(Model.IncluirSinIngresos ? "checked" : null) />
                                    <label for="chkSinIngresos" class="control-label mb-0">Incluir servicios sin ingresos</label>
                                </div>
                                <input type="hidden" name="incluirSinIngresos" id="hidSinIngresos" value="@(Model.IncluirSinIngresos ? "true" : "false")" />
                            </div>
                        </div>
                        <div class="col-md-2 d-flex">
                            <div class="form-group w-100">
                                <label class="control-label"></label>
                                <button type="submit" class="form-control btn btn-primary d-inline-block">Buscar</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="tab-pane fade @(mostrarPaciente ? "show active" : "")" id="tab-paciente" role="tabpanel" aria-labelledby="tab-paciente-tab">
                <form id="paciente-search" method="POST" action="@Url.Action("Paciente","Reportes")">
                    <input type="hidden" name="incluirSinIngresos" value="@(Model.IncluirSinIngresos ? "true" : "false")" />
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">Del</label>
                                <input required class="form-control" type="date" name="from_dt" id="from_paciente" value="@(Model.From == default(DateTime) ? "" : Model.From.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">Al</label>
                                <input required class="form-control" type="date" name="to_dt" id="to_paciente" value="@(Model.To == default(DateTime) ? "" : Model.To.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="control-label">Paciente (vacío = todos del rango)</label>
                                <select name="IdPaciente" id="idPaciente" class="form-control select2">
                                    <option value="">Todos los pacientes del rango</option>
                                    @{
                                        var pacientesDropdown = (ViewBag.PacientesDropdown as List<Paciente>) ?? Model.Pacientes;
                                        foreach (var paciente in pacientesDropdown)
                                        {
                                            <option value="@paciente.IdPaciente" selected="@(Model.Paciente != null && Model.Paciente.IdPaciente == paciente.IdPaciente ? "selected" : null)">@paciente.Nombre @paciente.Apellido - @paciente.Dpi</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3 d-flex">
                            <div class="form-group">
                                <label class="control-label"></label>
                                <button type="submit" id="paciente-search" class="form-control btn btn-primary d-inline-block">Buscar</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>


<!-- Reportes section -->
<div class="card w-100 shadow-lg mt-5" id="reporte">

    <div class="card-header bg-white">
        <h3 class="titulo">Reporte</h3>
    </div>
    <div class="card-body">
        <div class=" table-responsive ">
            @{
                if (Model.Paciente != null)
                {
                    <h5 class="enc table-title encabezado fw-normal" id="tabla-encabezado">
                        <span class="centered-span">
                            Resumen de consultas<br /><br>
                            Del &nbsp;&nbsp; @Model.From.ToString("dd/MM/yyyy") &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Al &nbsp;&nbsp; @Model.To.ToString("dd/MM/yyyy")
                        </span>
                        <br>
                        <br>
                        @{
                            decimal total = 0.0M;
                            foreach (var consulta in Model.Paciente.Consulta.Where(x => x.Terminada && x.Pagada && x.Fecha.Date >= Model.From.Date && x.Fecha.Date <= Model.To.Date))
                            {
                                total += consulta.Total;
                            }
                        }
                        Paciente: <span class="fw-bold"> @Model.Paciente.Nombre @Model.Paciente.Apellido &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span> DPI: <span class="fw-bold"> @Model.Paciente.Dpi </span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; No. Consultas: <span class="fw-bold"> @Model.Paciente.Consulta.Where(x => x.Terminada && x.Pagada && x.Fecha.Date >= Model.From.Date && x.Fecha.Date <= Model.To.Date).ToList().Count </span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Total: Q <span class="fw-bold">@total</span>

                        <br>
                        <br>
                    </h5>
                    <h5 class="visually-hidden table-title encabezado fw-normal hidden" id="tabla-encabezado2">
                        <span class="centered-span">
                            Resumen de consultas<br /><br>
                            Del &nbsp;&nbsp; @Model.From.ToString("dd/MM/yyyy") &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Al &nbsp;&nbsp; @Model.To.ToString("dd/MM/yyyy")
                        </span>
                        <br>
                        <br>
                        Paciente: <span class="fw-bold">
                            @Model.Paciente.Nombre @Model.Paciente.Apellido &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                        </span> Dpi: <span class="fw-bold">
                            @Model.Paciente.Dpi
                        </span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; No. Consultas: <span class="fw-bold">
                            @Model.Paciente.Consulta.Where(x => x.Terminada && x.Pagada && x.Fecha.Date >= Model.From.Date && x.Fecha.Date <= Model.To.Date).ToList().Count
                        </span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Total: Q
                        <span class="fw-bold">
                            @total
                        </span>

                        <br>
                        <br>
                    </h5>
                }
                else if (Model.VerTodosPacientes)
                {
                    var consultasAll = Model.Pacientes
                        .SelectMany(p => p.Consulta ?? new List<Consulta>())
                        .Where(x => x.Terminada && x.Pagada && x.Fecha.Date >= Model.From.Date && x.Fecha.Date <= Model.To.Date)
                        .ToList();
                    var totalAll = consultasAll.Sum(x => x.Total);
                    <h5 class="enc table-title encabezado fw-normal" id="tabla-encabezado">
                        <span class="centered-span">
                            Resumen de consultas por paciente<br /><br>
                            Del &nbsp;&nbsp; @Model.From.ToString("dd/MM/yyyy") &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Al &nbsp;&nbsp; @Model.To.ToString("dd/MM/yyyy")
                        </span>
                        <br>
                        <br>
                        No. Pacientes: <span class="fw-bold">@Model.Pacientes.Count</span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; No. Consultas: <span class="fw-bold">@consultasAll.Count</span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Total: Q <span class="fw-bold">@totalAll</span>
                        <br>
                        <br>
                        <div class="small text-muted fw-normal" style="font-size:0.8rem;">
                            Solo consultas terminadas y pagadas. Pulse <strong>+</strong> para ver el detalle de cada paciente.
                        </div>
                        <br>
                    </h5>
                }
                else if (Model.EsServicio)
                {
                    var tipoTitulo = (ViewBag.TipoFiltro as string) ?? Model.TipoFiltro ?? "todos";                    var nombreReporte = tipoTitulo == "servicios" ? "Resumen de ingresos por servicios"
                        : tipoTitulo == "productos" ? "Resumen de ingresos por productos"
                        : "Resumen de ingresos por servicios y productos";
                    <h5 class="enc table-title encabezado fw-normal" id="tabla-encabezado">
                        <span class="centered-span">
                            @nombreReporte<br /><br>
                            Del &nbsp;&nbsp; @Model.From.ToString("dd/MM/yyyy") &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Al &nbsp;&nbsp; @Model.To.ToString("dd/MM/yyyy")
                        </span>
                        <br>
                        <div class="small text-muted fw-normal" style="font-size:0.8rem;">
                            Solo cobros efectivos del rango (ventas pagadas y legados de consultas terminadas y pagadas).
                            Criterio de fechas: ventas por fecha de venta (caja), legados por fecha de consulta.
                            Lo pendiente de cobro va en la tabla "Cobros pendientes".
                        </div>
                        <br>
                    </h5>
                }
            }

            @if (Model.EsServicio)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <span class="text-muted small">Vista <strong>macro</strong>: resumen. Pulse <strong>+</strong> para ver el detalle; dentro del detalle, pulse <strong>+</strong> de cada día / servicio para ver los movimientos.</span>
                    <div class="btn-group ms-auto" role="group" aria-label="Vista del reporte">
                        <button type="button" id="vistaServicioBtn" class="btn btn-sm btn-primary">Por concepto</button>
                        <button type="button" id="vistaDiaBtn" class="btn btn-sm btn-outline-primary">Por día</button>
                    </div>
                    <button type="button" id="expandAllMicro" class="btn btn-sm btn-outline-secondary">Ver micro (expandir todo)</button>
                    <button type="button" id="collapseAllMicro" class="btn btn-sm btn-outline-secondary">Ver macro (colapsar todo)</button>
                </div>
            }
            @{
                // Almacén vista micro (macro = resumen). Se llena en el tbody y se renderiza en divs ocultos FUERA de la tabla.
                // El 6o campo es el tipo de pago de la venta que originó el movimiento (o "—" si es legado/sin pago).
                var microStore = new Dictionary<string, List<(DateTime Fecha, string Paciente, string Origen, decimal Cantidad, decimal Subtotal, string MetodoPago)>>();
                var microTitulos = new Dictionary<string, string>();
                // Vista inversa: macro por día, micro con el MISMO detalle que Por servicio
                // (Servicio/Producto, Paciente, Origen, Tipo pago, Cantidad, Subtotal).
                var microDiaStore = new Dictionary<string, List<(DateTime Fecha, string Servicio, string Paciente, string Origen, string MetodoPago, decimal Cantidad, decimal Subtotal)>>();
                // Por Paciente (todos): macro por paciente, micro con sus consultas.
                var microPacStore = new Dictionary<string, List<Consulta>>();
                var microPacTitulos = new Dictionary<string, string>();
                // Pagos del rango (venta -> pagos) y catálogo de tipos de pago, para el micro y la sumatoria.
                var pagosPorVenta = (ViewBag.PagosPorVenta as Dictionary<Guid, List<ClinicaDomain.VentaPago>>) ?? new Dictionary<Guid, List<ClinicaDomain.VentaPago>>();
                var metodosMap = (ViewBag.MetodosMap as Dictionary<Guid, string>) ?? new Dictionary<Guid, string>();
                var tipoFiltro = (((ViewBag.TipoFiltro as string) ?? Model.TipoFiltro ?? "todos").Trim().ToLower());
                if (tipoFiltro != "servicios" && tipoFiltro != "productos") { tipoFiltro = "todos"; }
                var verServicios = tipoFiltro == "todos" || tipoFiltro == "servicios";
                var verProductos = tipoFiltro == "todos" || tipoFiltro == "productos";
                string MetodoDeVenta(Guid idVenta)
                {
                    if (!pagosPorVenta.TryGetValue(idVenta, out var lista) || lista.Count == 0) return "—";
                    var nombres = lista
                        .Select(p => metodosMap.TryGetValue(p.IdMetodoPago, out var n) ? n : "—")
                        .Where(n => !string.IsNullOrWhiteSpace(n))
                        .Distinct()
                        .ToList();
                    return nombres.Count == 0 ? "—" : string.Join(" + ", nombres);
                }
            }
            <div id="vistaServicio">
            <table id="table" class="table table-striped ">
                <thead class="table-dark">
                    @{
                        if (Model.EsServicio)
                        {
                            <tr>
                                <th></th>
                                <th>Descripción</th>
                                <th>Cantidad</th>
                                <th>Total</th>
                            </tr>
                            <script>
                                var custom_file_name = "Resumen Servicios (@Model.From.ToString("dd-MM-yyyy") - @Model.To.ToString("dd-MM-yyyy"))"
                                var num_columns = [1, 2, 3]
                                var encabezado = document.getElementById("tabla-encabezado").textContent;
                                var titulo = "Resumen de ingresos"
                                var fechas = "Del  @Model.From.ToString("dd/MM/yyyy")       Al  @Model.To.ToString("dd/MM/yyyy")"
                            </script>
                        }
                        else if (Model.Paciente != null)
                        {
                            <tr>
                                <th>Fecha de creación</th>
                                <th>Duración</th>
                                <th>Motivo de consulta</th>
                                <th>Radiografías</th>
                                <th>Total</th>
                            </tr>
                            <script>
                                var custom_file_name = "Consultas @Model.Paciente.Nombre @Model.Paciente.Apellido (@Model.From.ToString("dd-MM-yyyy") - @Model.To.ToString("dd-MM-yyyy"))"
                                var num_columns = [0, 1, 2, 3, 4]
                                var encabezado = document.getElementById("tabla-encabezado").textContent;
                                var titulo = "Resumen de consultas"
                                var fechas = "Del  @Model.From.ToString("dd/MM/yyyy")       Al  @Model.To.ToString("dd/MM/yyyy")"
                            </script>
                        }
                        else if (Model.VerTodosPacientes)
                        {
                            <tr>
                                <th></th>
                                <th>Paciente</th>
                                <th>DPI</th>
                                <th>No. Consultas</th>
                                <th>Total</th>
                            </tr>
                            <script>
                                var custom_file_name = "Consultas por paciente (@Model.From.ToString("dd-MM-yyyy") - @Model.To.ToString("dd-MM-yyyy"))"
                                var num_columns = [1, 2, 3, 4]
                                var encabezado = document.getElementById("tabla-encabezado").textContent;
                                var titulo = "Resumen de consultas por paciente"
                                var fechas = "Del  @Model.From.ToString("dd/MM/yyyy")       Al  @Model.To.ToString("dd/MM/yyyy")"
                            </script>
                        }
                        else
                        {
                            <script>
                                var custom_file_name = ""
                                var num_columns = []
                                var encabezado = ""
                                var titulo = ""
                                var fechas = ""
                            </script>
                            <tr><th></th></tr>
                        }
                    }
                </thead>
                <tbody>
                    @{
                        var granCantidadFoot = 0;
                        var granTotalFoot = 0.0M;
                        if (Model.Paciente != null)
                        {
                            foreach (var consulta in Model.Paciente.Consulta.Where(x => x.Terminada && x.Pagada && x.Fecha.Date >= Model.From.Date && x.Fecha.Date <= Model.To.Date))
                            {
                                <tr>
                                    <td>@DateManager.GetDisplayDate(consulta.FechaCreacion, consulta.Fecha)</td>
                                    <td>@consulta.TiempoDuracion min</td>
                                    <td>@consulta.MotivoConsulta</td>
                                    @if (consulta.Radiografias)
                                    {
                                        <td>Si</td>
                                    }
                                    else
                                    {
                                        <td>No</td>
                                    }
                                    <td>
                                        <div class="options d-flex ">
                                            <button class="btn-total option btn" data-id="@consulta.IdConsulta">Q @consulta.Total</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else if (Model.VerTodosPacientes)
                        {
                            microPacStore.Clear();
                            microPacTitulos.Clear();
                            var granConsPac = 0;
                            var granTotPac = 0.0M;
                            foreach (var pac in Model.Pacientes.OrderBy(p => p.Nombre).ThenBy(p => p.Apellido))
                            {
                                var consPac = (pac.Consulta ?? new List<Consulta>())
                                    .Where(x => x.Terminada && x.Pagada && x.Fecha.Date >= Model.From.Date && x.Fecha.Date <= Model.To.Date)
                                    .OrderBy(x => x.Fecha)
                                    .ToList();
                                var totPac = consPac.Sum(x => x.Total);
                                granConsPac += consPac.Count;
                                granTotPac += totPac;
                                var microPacId = $"micro-pac-{pac.IdPaciente}";
                                microPacStore[microPacId] = consPac;
                                microPacTitulos[microPacId] = $"{pac.Nombre} {pac.Apellido}";
                                <tr class="macro-row">
                                    <td>
                                        @if (consPac.Count > 0)
                                        {
                                            <button type="button" class="btn-micro btn btn-sm btn-outline-primary" data-micro="@microPacId" title="Ver detalle">+</button>
                                        }
                                    </td>
                                    <td>@pac.Nombre @pac.Apellido</td>
                                    <td>@pac.Dpi</td>
                                    <td>@consPac.Count</td>
                                    <td>Q @totPac</td>
                                </tr>
                            }
                            granCantidadFoot = granConsPac;
                            granTotalFoot = granTotPac;
                        }
                        else if (Model.EsServicio)
                        {
                            // Lookups para la vista micro: consulta -> (fecha, paciente), venta -> (fecha, folio, paciente).
                            var consultasPorId = Model.Pacientes
                                .SelectMany(p => (p.Consulta ?? new List<Consulta>()).Select(c => new { C = c, P = p }))
                                .GroupBy(x => x.C.IdConsulta)
                                .ToDictionary(g => g.Key, g => g.First());
                            var todasVentas = (ViewBag.Ventas as List<ClinicaDomain.Venta>) ?? new List<ClinicaDomain.Venta>();
                            var ventasPorId = todasVentas.GroupBy(v => v.IdVenta).ToDictionary(g => g.Key, g => g.First());
                            var todosVentaDetalles = (ViewBag.VentaDetalles as List<ClinicaDomain.VentaDetalle>) ?? new List<ClinicaDomain.VentaDetalle>();
                            var pacientesMap = (ViewBag.PacientesMap as Dictionary<Guid, string>) ?? new Dictionary<Guid, string>();
                            var granCantidad = 0;
                            var granTotal = 0.0M;
                            microStore.Clear();
                            microTitulos.Clear();
                            if (verServicios)
                            {
                            foreach (var servicio in Model.Servicios)
                            {
                                var cantidad = 0;
                                var total = 0.0M;
                                var micro = new List<(DateTime Fecha, string Paciente, string Origen, decimal Cantidad, decimal Subtotal, string MetodoPago)>();
                                @foreach (var paciente in Model.Pacientes)
                                {
                                    foreach (var consulta in (paciente.Consulta ?? new List<Consulta>()).Where(x => x.Fecha.Date >= Model.From.Date && x.Fecha.Date <= Model.To.Date))
                                    {
                                        @foreach (var detalle in (Model.Detalles ?? new List<DetalleCobro>()).Where(x => x.IdMotivoCobro == servicio.IdMotivoCobro && x.IdConsulta == consulta.IdConsulta))
                                        {
                                            cantidad += detalle.Cantidad;
                                            total += detalle.Subtotal;
                                            micro.Add((consulta.Fecha, $"{paciente.Nombre} {paciente.Apellido}", "Consulta (legado)", detalle.Cantidad, detalle.Subtotal, "—"));
                                        }
                                    }
                                }
                                foreach (var d in todosVentaDetalles.Where(x => x.TipoLinea == "Servicio" && x.IdMotivoCobro == servicio.IdMotivoCobro))
                                {
                                    cantidad += (int)d.Cantidad;
                                    total += d.Subtotal;
                                    DateTime fVenta = Model.From;
                                    string nomPaciente = "Mostrador";
                                    string origen = "Venta";
                                    if (ventasPorId.TryGetValue(d.IdVenta, out var v))
                                    {
                                        fVenta = v.Fecha;
                                        origen = string.IsNullOrWhiteSpace(v.Folio) ? "Venta" : $"Venta {v.Folio}";
                                        origen += v.IdConsulta != null ? " (consulta)" : " (mostrador)";
                                        if (v.IdPaciente != null && pacientesMap.TryGetValue(v.IdPaciente.Value, out var nom))
                                        {
                                            nomPaciente = nom;
                                        }
                                        else if (v.IdConsulta != null && consultasPorId.TryGetValue(v.IdConsulta.Value, out var cc))
                                        {
                                            nomPaciente = $"{cc.P.Nombre} {cc.P.Apellido}";
                                        }
                                    }
                                    micro.Add((fVenta, nomPaciente, origen, d.Cantidad, d.Subtotal, MetodoDeVenta(d.IdVenta)));
                                }
                                micro = micro.OrderBy(m => m.Fecha).ToList();
                                // Check apagado (default): ocultar servicios sin movimientos en el rango.
                                if (cantidad == 0 && !Model.IncluirSinIngresos)
                                {
                                    continue;
                                }
                                granCantidad += cantidad;
                                granTotal += total;
                                var microId = $"micro-{servicio.IdMotivoCobro}";
                                microStore[microId] = micro;
                                microTitulos[microId] = servicio.Descripcion;
                                <tr class="macro-row fila-servicio">
                                    <td>
                                        @if (cantidad > 0)
                                        {
                                            <button type="button" class="btn-micro btn btn-sm btn-outline-primary" data-micro="@microId" title="Ver detalle">+</button>
                                        }
                                    </td>
                                    <td>@servicio.Descripcion</td>
                                    <td>@cantidad</td>
                                    <td>Q @total</td>
                                </tr>
                            }
                            }
                            // Productos + ventas libres del rango, también con micro.
                            if (verProductos)
                            {
                            var prodGroups = todosVentaDetalles.Where(x => x.TipoLinea == "Producto").GroupBy(x => x.Descripcion).ToList();
                            var prodIdx = 0;
                            foreach (var g in prodGroups)
                            {
                                var prodCantidad = g.Sum(x => x.Cantidad);
                                var prodTotal = g.Sum(x => x.Subtotal);
                                granCantidad += (int)prodCantidad;
                                granTotal += prodTotal;
                                var prodMicroId = $"micro-prod-{prodIdx}";
                                prodIdx++;
                                var prodMicro = new List<(DateTime Fecha, string Paciente, string Origen, decimal Cantidad, decimal Subtotal, string MetodoPago)>();
                                foreach (var d in g.OrderBy(x => ventasPorId.ContainsKey(x.IdVenta) ? ventasPorId[x.IdVenta].Fecha : DateTime.MaxValue))
                                {
                                    var fV = Model.From;
                                    var nP = "Mostrador";
                                    var oR = "Venta";
                                    if (ventasPorId.TryGetValue(d.IdVenta, out var vv))
                                    {
                                        fV = vv.Fecha;
                                        oR = string.IsNullOrWhiteSpace(vv.Folio) ? "Venta" : $"Venta {vv.Folio}";
                                        oR += vv.IdConsulta != null ? " (consulta)" : " (mostrador)";
                                        if (vv.IdPaciente != null && pacientesMap.TryGetValue(vv.IdPaciente.Value, out var nn))
                                        {
                                            nP = nn;
                                        }
                                        else if (vv.IdConsulta != null && consultasPorId.TryGetValue(vv.IdConsulta.Value, out var ccc))
                                        {
                                            nP = $"{ccc.P.Nombre} {ccc.P.Apellido}";
                                        }
                                    }
                                    prodMicro.Add((fV, nP, oR, d.Cantidad, d.Subtotal, MetodoDeVenta(d.IdVenta)));
                                }
                                microStore[prodMicroId] = prodMicro;
                                microTitulos[prodMicroId] = $"{g.Key} (producto)";
                                <tr class="macro-row fila-producto">
                                    <td><button type="button" class="btn-micro btn btn-sm btn-outline-primary" data-micro="@prodMicroId" title="Ver detalle">+</button></td>
                                    <td>@g.Key (producto)</td>
                                    <td>@prodCantidad</td>
                                    <td>Q @prodTotal</td>
                                </tr>
                            }
                            }
                            granCantidadFoot = granCantidad;
                            granTotalFoot = granTotal;
                        }
                    }
                </tbody>
                @if (Model.EsServicio || Model.VerTodosPacientes)
                {
                    <tfoot class="table-dark fw-bold">
                        <tr>
                            <td></td>
                            <td>Total general</td>
                            <td>@granCantidadFoot</td>
                            <td>Q @granTotalFoot</td>
                        </tr>
                    </tfoot>
                }
            </table>
            </div><!-- /vistaServicio -->
            @if (Model.EsServicio)
            {
                // Vista inversa: macro por día (solo días con movimiento), micro resumido por servicio.
                <div id="vistaDia" style="display:none;">
                    <table id="tableDia" class="table table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th></th>
                                <th>Fecha</th>
                                <th>Cantidad</th>
                                <th>Total</th>
                            </tr>
                            <script>
                                var custom_file_name_dia = "Resumen Por Dia (@Model.From.ToString("dd-MM-yyyy") - @Model.To.ToString("dd-MM-yyyy"))"
                                var num_columns_dia = [1, 2, 3]
                            </script>
                        </thead>
                        <tbody>
                            @{
                                var diasConMov = microStore.SelectMany(kv => kv.Value.Select(m => m.Fecha.Date)).Distinct().OrderBy(f => f).ToList();
                                var granCantDia = 0M;
                                var granTotDia = 0M;
                                foreach (var dia in diasConMov)
                                {
                                    // Mismo grano que el micro Por servicio: un movimiento por línea,
                                    // solo que agrupado por día y con la columna Servicio/Producto.
                                    var movsDia = new List<(DateTime Fecha, string Servicio, string Paciente, string Origen, string MetodoPago, decimal Cantidad, decimal Subtotal)>();
                                    foreach (var kv in microStore)
                                    {
                                        var nombreFila = microTitulos.ContainsKey(kv.Key) ? microTitulos[kv.Key] : kv.Key;
                                        foreach (var m in kv.Value.Where(m => m.Fecha.Date == dia))
                                        {
                                            movsDia.Add((m.Fecha, nombreFila, m.Paciente, m.Origen, m.MetodoPago, m.Cantidad, m.Subtotal));
                                        }
                                    }
                                    movsDia = movsDia.OrderBy(x => x.Servicio).ThenBy(x => x.Paciente).ToList();
                                    var cantDia = movsDia.Sum(f => f.Cantidad);
                                    var totDia = movsDia.Sum(f => f.Subtotal);
                                    granCantDia += cantDia;
                                    granTotDia += totDia;
                                    var microDiaId = $"micro-dia-{dia:yyyyMMdd}";
                                    microDiaStore[microDiaId] = movsDia;
                                    <tr class="macro-row">
                                        <td><button type="button" class="btn-micro-dia btn btn-sm btn-outline-primary" data-micro="@microDiaId" title="Ver detalle">+</button></td>
                                        <td>@dia.ToString("dd/MM/yyyy")</td>
                                        <td>@cantDia</td>
                                        <td>Q @totDia</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-dark fw-bold">
                            <tr>
                                <td></td>
                                <td>Total general</td>
                                <td>@granCantDia</td>
                                <td>Q @granTotDia</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            @if (Model.EsServicio)
            {
                // Sumatoria por tipo de pago (prorrateada por línea para respetar el filtro servicios/productos).
                // Solo cobros efectivos: ventas Pagadas + legados de consultas terminadas y pagadas.
                var ventasRango = (ViewBag.Ventas as List<ClinicaDomain.Venta>) ?? new List<ClinicaDomain.Venta>();
                var detallesRango = (ViewBag.VentaDetalles as List<ClinicaDomain.VentaDetalle>) ?? new List<ClinicaDomain.VentaDetalle>();
                var totalesMetodo = new Dictionary<string, decimal>();
                var ventasSetMetodo = new Dictionary<string, HashSet<Guid>>();
                var ventasContadas = new HashSet<Guid>();
                void AcumularMetodo(string nombre, decimal monto, Guid? idVenta)
                {
                    if (string.IsNullOrWhiteSpace(nombre)) { nombre = "—"; }
                    if (!totalesMetodo.ContainsKey(nombre)) { totalesMetodo[nombre] = 0; ventasSetMetodo[nombre] = new HashSet<Guid>(); }
                    totalesMetodo[nombre] += monto;
                    if (idVenta.HasValue) { ventasSetMetodo[nombre].Add(idVenta.Value); }
                }
                foreach (var v in ventasRango)
                {
                    var lineasV = detallesRango.Where(d => d.IdVenta == v.IdVenta);
                    if (tipoFiltro == "servicios") { lineasV = lineasV.Where(d => d.TipoLinea == "Servicio"); }
                    else if (tipoFiltro == "productos") { lineasV = lineasV.Where(d => d.TipoLinea == "Producto"); }
                    var subF = lineasV.Sum(d => (decimal?)d.Subtotal) ?? 0;
                    if (subF == 0) { continue; }
                    ventasContadas.Add(v.IdVenta);
                    if (!pagosPorVenta.TryGetValue(v.IdVenta, out var pagosV) || pagosV.Count == 0)
                    {
                        AcumularMetodo("SIN REGISTRO", subF, v.IdVenta);
                        continue;
                    }
                    var baseCalc = v.Total > 0 ? v.Total : pagosV.Sum(p => p.Monto);
                    if (baseCalc <= 0)
                    {
                        AcumularMetodo("SIN REGISTRO", subF, v.IdVenta);
                        continue;
                    }
                    foreach (var pg in pagosV)
                    {
                        var nombreM = metodosMap.TryGetValue(pg.IdMetodoPago, out var nm) ? nm : "—";
                        AcumularMetodo(nombreM, subF * (pg.Monto / baseCalc), v.IdVenta);
                    }
                }
                if (verServicios && Model.Detalles != null && Model.Pacientes != null)
                {
                    var consultasEnRango = Model.Pacientes
                        .SelectMany(p => p.Consulta ?? new List<Consulta>())
                        .Where(c => c.Fecha.Date >= Model.From.Date && c.Fecha.Date <= Model.To.Date)
                        .Select(c => c.IdConsulta)
                        .ToHashSet();
                    var legadoTotal = Model.Detalles.Where(d => consultasEnRango.Contains(d.IdConsulta)).Sum(d => (decimal?)d.Subtotal) ?? 0;
                    if (legadoTotal != 0) { AcumularMetodo("SIN REGISTRO", legadoTotal, null); }
                }
                var totalMetodos = totalesMetodo.Values.Sum();
                <div class="mt-4" id="totalesPorPago">
                    <h5 class="fw-bold mb-1">Totales por tipo de pago @(tipoFiltro == "todos" ? "" : (tipoFiltro == "servicios" ? "(solo servicios)" : "(solo productos)"))</h5>
                    <div class="small text-muted mb-2">Si una venta se pagó con varios tipos, el monto se reparte proporcionalmente entre sus líneas. Los cobros legados (de consultas terminadas y pagadas, sin registro de tipo de pago) se agrupan en SIN REGISTRO. Lo pendiente de cobro no suma aquí: va en la tabla "Cobros pendientes".</div>
                    <div class="table-responsive">
                    <table id="tablaTotalesPago" class="table table-striped">
                        <thead class="table-dark">
                            <tr><th>Tipo de pago</th><th>Ventas</th><th>Total</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var kvp in totalesMetodo.OrderByDescending(x => x.Value))
                            {
                                <tr>
                                    <td>@kvp.Key</td>
                                    <td>@(ventasSetMetodo.TryGetValue(kvp.Key, out var setV) ? setV.Count : 0)</td>
                                    <td>Q @Math.Round(kvp.Value, 2)</td>
                                </tr>
                            }
                            @if (totalesMetodo.Count == 0)
                            {
                                <tr><td colspan="3" class="text-center text-muted">Sin movimientos en el rango.</td></tr>
                            }
                        </tbody>
                        <tfoot class="table-dark fw-bold">
                            <tr><td>Total general</td><td>@ventasContadas.Count</td><td>Q @Math.Round(totalMetodos, 2)</td></tr>
                        </tfoot>
                    </table>
                    </div>
                </div>
            }
            @if (Model.EsServicio)
            {
                // Cobros pendientes: ventas en caja o con saldo por cobrar + legados de
                // consultas no pagadas. No suman en los totales de arriba.
                var ventasPend = (ViewBag.VentasPendientes as List<ClinicaDomain.Venta>) ?? new List<ClinicaDomain.Venta>();
                var mapaPacPend = (ViewBag.PacientesMap as Dictionary<Guid, string>) ?? new Dictionary<Guid, string>();
                var legPend = (ViewBag.DetallesPendientes as List<DetalleCobro>) ?? new List<DetalleCobro>();
                var consultasConVenta = (ViewBag.ConsultasConVenta as HashSet<Guid>) ?? new HashSet<Guid>();
                var filasPend = new List<(DateTime Fecha, string Paciente, string Origen, decimal Total, decimal Abonado, string Estado)>();
                foreach (var v in ventasPend)
                {
                    var abonado = pagosPorVenta.TryGetValue(v.IdVenta, out var pgsV) ? pgsV.Sum(p => p.Monto) : 0;
                    var nomV = v.IdPaciente.HasValue && mapaPacPend.TryGetValue(v.IdPaciente.Value, out var nmV) ? nmV : "Mostrador";
                    var orgV = (string.IsNullOrWhiteSpace(v.Folio) ? "Venta" : $"Venta {v.Folio}") + (v.IdConsulta != null ? " (consulta)" : " (mostrador)");
                    var estV = v.Estado;
                    if (!string.IsNullOrWhiteSpace(v.FiadoResponsable)) { estV += $" — {v.FiadoResponsable}"; }
                    if (v.FechaPromesa.HasValue) { estV += $" (promesa {v.FechaPromesa.Value:dd/MM/yyyy})"; }
                    filasPend.Add((v.Fecha, nomV, orgV, v.Total, abonado, estV));
                }
                if (Model.Pacientes != null)
                {
                    var consultasPend = Model.Pacientes
                        .SelectMany(p => (p.Consulta ?? new List<Consulta>()).Select(c => new { C = c, P = p }))
                        .Where(x => x.C.Fecha.Date >= Model.From.Date && x.C.Fecha.Date <= Model.To.Date
                            && !(x.C.Terminada && x.C.Pagada)
                            && !consultasConVenta.Contains(x.C.IdConsulta))
                        .ToList();
                    foreach (var x in consultasPend)
                    {
                        var totLeg = legPend.Where(d => d.IdConsulta == x.C.IdConsulta).Sum(d => (decimal?)d.Subtotal) ?? 0;
                        if (totLeg == 0) { continue; }
                        filasPend.Add((x.C.Fecha, $"{x.P.Nombre} {x.P.Apellido}", "Consulta (legado)", totLeg, 0, "Consulta pendiente de pago"));
                    }
                }
                filasPend = filasPend.OrderBy(f => f.Fecha).ToList();
                var totPendTotal = filasPend.Sum(f => f.Total);
                var totPendAbonado = filasPend.Sum(f => f.Abonado);
                <div class="mt-4" id="cobrosPendientes">
                    <h5 class="fw-bold mb-1">Cobros pendientes</h5>
                    <div class="small text-muted mb-2">Ventas en caja o con saldo por cobrar, más legados de consultas no pagadas. No suman en los totales de arriba.</div>
                    <div class="table-responsive">
                    <table id="tablaPendientes" class="table table-striped">
                        <thead class="table-dark">
                            <tr><th>Fecha</th><th>Paciente</th><th>Origen</th><th>Total</th><th>Abonado</th><th>Saldo</th><th>Estado</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var fp in filasPend)
                            {
                                <tr>
                                    <td>@fp.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@fp.Paciente</td>
                                    <td>@fp.Origen</td>
                                    <td>Q @fp.Total</td>
                                    <td>Q @fp.Abonado</td>
                                    <td class="fw-bold">Q @(fp.Total - fp.Abonado)</td>
                                    <td>@fp.Estado</td>
                                </tr>
                            }
                            @if (filasPend.Count == 0)
                            {
                                <tr><td colspan="7" class="text-center text-muted">Sin cobros pendientes en el rango.</td></tr>
                            }
                        </tbody>
                        <tfoot class="table-dark fw-bold">
                            <tr><td colspan="3">Total pendiente</td><td>Q @totPendTotal</td><td>Q @totPendAbonado</td><td>Q @(totPendTotal - totPendAbonado)</td><td></td></tr>
                        </tfoot>
                    </table>
                    </div>
                </div>
            }
            @if (Model.EsServicio && microStore.Count > 0)
            {
                <div style="display:none;" aria-hidden="true">
                    @foreach (var kv in microStore)
                    {
                        var titulo = microTitulos.ContainsKey(kv.Key) ? microTitulos[kv.Key] : kv.Key;
                        var gruposFecha = kv.Value.GroupBy(m => m.Fecha.Date).OrderBy(g => g.Key).ToList();
                        <div id="@kv.Key">
                            <div class="micro-wrap p-2">
                                <div class="small text-muted mb-1">Micro: @titulo — @kv.Value.Count movimiento(s) en @gruposFecha.Count día(s). Pulse <strong>+</strong> de cada día para ver los movimientos.</div>
                                <table class="table table-sm table-bordered mb-0 micro-table">
                                    <thead class="table-light">
                                        <tr><th style="width:42px;"></th><th>Fecha</th><th>Movimientos</th><th>Cantidad</th><th>Subtotal</th></tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var gi = 0;
                                        }
