@model List<ClinicaDomain.Venta>
@{
    ViewData["Title"] = "Ventas de mostrador";
    var pendientesPago = (List<ClinicaDomain.Venta>)ViewBag.PendientesPago;
    var saldos = (Dictionary<Guid, decimal>)ViewBag.SaldosPendientesPago;
    var historial = (List<ClinicaDomain.Venta>)(ViewBag.Historial ?? new List<ClinicaDomain.Venta>());
    var saldosHist = (Dictionary<Guid, decimal>)(ViewBag.SaldosHistorial ?? new Dictionary<Guid, decimal>());
    var pacientesMap = (Dictionary<Guid, string>)(ViewBag.PacientesMap ?? new Dictionary<Guid, string>());
    string NomPaciente(Guid? id) => id.HasValue && pacientesMap.TryGetValue(id.Value, out var n) ? n : "—";
    var tabActiva = Model.Any() ? "cobrar" : pendientesPago.Any() ? "fiadas" : "historial";
}
@section Links{
    <style>
        /* Barra contenedora: separa los tabs del fondo de la página */
        .tabs-subnav { background: #e9f0ed; border: 1px solid #dee2e6; border-bottom: 0; border-radius: 10px 10px 0 0; padding: 6px 10px 0; gap: 4px; }
        .tabs-subnav .nav-link { border: 0; border-radius: 8px 8px 0 0; color: #495057; font-weight: 500; padding: 10px 14px; position: relative; }
        .tabs-subnav .nav-link:hover { color: #2d8f77; background: #fff; }
        .tabs-subnav .nav-link.active { color: #2d8f77; font-weight: 700; background: #fff; }
        .tabs-subnav .nav-link.active::after { content: ""; position: absolute; left: 8px; right: 8px; bottom: 0; height: 3px; border-radius: 3px 3px 0 0; background: #2d8f77; }
        .tabs-subnav .nav-link .badge { font-weight: 600; }
        /* El card se fusiona con la barra (sin borde superior ni esquinas de arriba) */
        .tabs-panel { border-top: 0; border-top-left-radius: 0; border-top-right-radius: 0; }
    </style>
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-5">
    <h3 class="h3 mb-0">Ventas libres (mostrador)</h3>
</div>
<ul class="nav tabs-subnav mt-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(tabActiva == "cobrar" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabCobrar" type="button" role="tab" aria-selected="@(tabActiva == "cobrar" ? "true" : "false")"><i class="fa-solid fa-cash-register"></i> Mostrador <span class="badge @(tabActiva == "cobrar" ? "bg-success" : "bg-secondary")">@Model.Count</span></button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(tabActiva == "fiadas" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabFiadas" type="button" role="tab" aria-selected="@(tabActiva == "fiadas" ? "true" : "false")"><i class="fa-solid fa-hand-holding-dollar"></i> Pendientes de pago <span class="badge @(tabActiva == "fiadas" ? "bg-success" : "bg-warning text-dark")">@pendientesPago.Count</span></button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(tabActiva == "historial" ? "active" : "")" data-bs-toggle="tab" data-bs-target="#tabHistorial" type="button" role="tab" aria-selected="@(tabActiva == "historial" ? "true" : "false")"><i class="fa-solid fa-clock-rotate-left"></i> Historial <span class="badge @(tabActiva == "historial" ? "bg-success" : "bg-secondary")">@historial.Count</span></button>
    </li>
</ul>
<div class="card w-100 shadow-lg mt-0 border-top-0 tabs-panel">
    @if (TempData["GuardadoTemporal"] is string msgGuardado && !string.IsNullOrWhiteSpace(msgGuardado))
    {
        <div class="alert alert-success alert-dismissible fade show m-3 mb-0" role="alert">
            <i class="fa-solid fa-floppy-disk me-1"></i>@msgGuardado
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    else if (Context.Request.Query.TryGetValue("guardado", out var folioGuardado) && !string.IsNullOrWhiteSpace(folioGuardado))
    {
        <div class="alert alert-success alert-dismissible fade show m-3 mb-0" role="alert">
            <i class="fa-solid fa-floppy-disk me-1"></i>Cuenta @folioGuardado guardada — queda pendiente de cobro.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card-body">
        <div class="tab-content">
            <div class="tab-pane fade @(tabActiva == "cobrar" ? "show active" : "")" id="tabCobrar" role="tabpanel">
                <p class="text-muted small">Aquí se generan <b>ventas sin consulta</b> (ej. solo compra una plantilla). Las de consulta se cobran en <a href="/Pagos">Pagar Consultas</a>. Ambas descuentan el mismo inventario al pagar.</p>
                <form method="POST" action="@Url.Action("CrearLibre","Ventas")" class="d-flex gap-2 mb-3">
                    <input name="observaciones" class="form-control form-control-sm" placeholder="Nota de esta venta (ej. plantilla azul talla M)" title="Nota que queda guardada en la venta y se ve en el historial" />
                    <button type="submit" class="btn btn-dark btn-sm text-nowrap"><i class="fa-solid fa-plus"></i> Nueva venta</button>
                </form>
                <div class="table-responsive">
                    <table id="table" class="table table-striped tabla-config" data-search-placeholder="Buscar venta pendiente" data-export-name="VentasPendientes">
                        <thead class="table-dark">
                            <tr>
                                <th>Folio</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td>@v.Folio</td>
                                    <td>@v.Fecha.ToString("g")</td>
                                    <td>Q@(v.Total.ToString("0.00"))</td>
                                    <td>@v.Estado</td>
                                    <td><a class="btn btn-outline-info btn-sm" href="@Url.Action("Cobrar","Ventas",new{id=v.IdVenta})">Cobrar</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade @(tabActiva == "fiadas" ? "show active" : "")" id="tabFiadas" role="tabpanel">
                @if (!pendientesPago.Any())
                {
                    <p class="text-muted small mb-0">Sin cuentas pendientes de pago.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped tabla-config" data-search-placeholder="Buscar pendiente de pago" data-export-name="PendientesPago">
                            <thead class="table-dark">
                                <tr>
                                    <th>Folio</th>
                                    <th>Responsable</th>
                                    <th>Promesa</th>
                                    <th>Total</th>
                                    <th>Saldo</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in pendientesPago)
                                {
                                    <tr class="@(v.FechaPromesa.HasValue && v.FechaPromesa.Value.Date < DateTime.Today ? "table-danger" : "")">
                                        <td>@v.Folio<br /><small class="text-muted">@v.Fecha.ToString("g")</small></td>
                                        <td>@v.FiadoResponsable</td>
                                        <td>@(v.FechaPromesa.HasValue ? v.FechaPromesa.Value.ToString("dd/MM/yyyy") : "—")</td>
                                        <td>Q@(v.Total.ToString("0.00"))</td>
                                        <td class="fw-bold">Q@(saldos[v.IdVenta].ToString("0.00"))</td>
                                        <td><a class="btn btn-outline-warning btn-sm" href="@Url.Action("Cobrar","Ventas",new{id=v.IdVenta})">Cobrar</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="tab-pane fade @(tabActiva == "historial" ? "show active" : "")" id="tabHistorial" role="tabpanel">
                <form method="GET" action="@Url.Action("Index","Ventas")" class="d-flex flex-wrap gap-2 align-items-end mb-3">
                    <div>
                        <label class="small fw-bold">Desde</label>
                        <input type="date" name="from" value="@ViewBag.HistorialFrom" class="form-control form-control-sm" />
                    </div>
                    <div>
                        <label class="small fw-bold">Hasta</label>
                        <input type="date" name="to" value="@ViewBag.HistorialTo" class="form-control form-control-sm" />
                    </div>
                    <div>
                        <label class="small fw-bold">Folio / responsable</label>
                        <input name="texto" value="@ViewBag.HistorialTexto" class="form-control form-control-sm" placeholder="V-20240101-XXXX" />
                    </div>
                    <button type="submit" class="btn btn-dark btn-sm">Buscar</button>
                </form>
                <p class="text-muted small">Para corregir un precio mal puesto: <b>Ver → Reabrir con motivo → corrige cantidad/precio → Completar pago</b>. Para devolverlo todo: <b>Ver → Devolver</b> (reingresa inventario).</p>
                @if (!historial.Any())
                {
                    <p class="text-muted small mb-0">Sin ventas en este rango.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped tabla-config" data-search-placeholder="Buscar en historial" data-export-name="VentasHistorial">
                            <thead class="table-dark">
                                <tr>
                                    <th>Folio</th>
                                    <th>Fecha</th>
                                    <th>Paciente</th>
                                    <th>Tipo</th>
                                    <th>Total</th>
                                    <th>Saldo</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in historial)
                                {
                                    <tr class="@(v.Estado == "Anulada" ? "table-secondary" : "")">
                                        <td>@v.Folio</td>
                                        <td>@v.Fecha.ToString("g")</td>
                                        <td>@NomPaciente(v.IdPaciente)</td>
                                        <td>@(v.IdConsulta.HasValue ? "Consulta" : "Mostrador")</td>
                                        <td>Q@(v.Total.ToString("0.00"))</td>
                                        <td class="fw-bold">Q@((saldosHist.TryGetValue(v.IdVenta, out var s) ? s : 0).ToString("0.00"))</td>
                                        <td><span class="badge @(v.Estado == "Pagada" ? "bg-success" : "bg-secondary")">@v.Estado</span></td>
                                        <td><a class="btn btn-outline-info btn-sm" href="@Url.Action("Ver","Ventas",new{id=v.IdVenta})">Ver / corregir</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <partial name="_DataTablesButtonsScripts" />
    <script src="~/js/pages/tablas-config.js" asp-append-version="true"></script>
    <script>
        // DataTables dentro de tabs ocultos calculan mal el ancho: reajustar al mostrar
        document.querySelectorAll('button[data-bs-toggle="tab"]').forEach(function (btn) {
            btn.addEventListener('shown.bs.tab', function (e) {
                var pane = document.querySelector(e.target.getAttribute('data-bs-target'));
                if (!pane || !window.jQuery) return;
                pane.querySelectorAll('.tabla-config').forEach(function (t) {
                    try {
                        var dt = jQuery(t).DataTable();
                        dt.columns.adjust().responsive.recalc();
                    } catch (err) { /* tabla sin datos */ }
                });
            });
        });
    </script>
}
