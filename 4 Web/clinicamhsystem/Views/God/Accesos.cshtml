@{
    ViewData["Title"] = "God Mode · Accesos";
    var usuario = (ClinicaDomain.Usuario)ViewBag.Usuario;
    var asignadas = (List<ClinicaDomain.UsuarioClinica>)(ViewBag.Asignadas ?? new List<ClinicaDomain.UsuarioClinica>());
    var clinicas = (List<ClinicaDomain.Clinica>)(ViewBag.Clinicas ?? new List<ClinicaDomain.Clinica>());
    var permisos = (List<string>)(ViewBag.Permisos ?? new List<string>());
    var ids = new HashSet<Guid>(asignadas.Select(a => a.IdClinica));
    var def = asignadas.FirstOrDefault(a => a.EsDefault)?.IdClinica;
}
@section Links {
    <style>
        .god-card { border: 0; border-radius: 1rem; box-shadow: 0 .25rem 1rem rgba(16,24,40,.08); }
        .god-card .card-header { background: transparent; border-bottom: 1px solid #eef1f6; font-weight: 700; }
    </style>
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">God Mode</a></li>
        <li class="breadcrumb-item"><a asp-action="Usuarios">Usuarios</a></li>
        <li class="breadcrumb-item active" aria-current="page">@usuario.NombreUsuario</li>
    </ol>
</nav>

<h2><i class="fa-solid fa-key me-2"></i>Accesos de <span class="badge bg-dark">@usuario.NombreUsuario</span></h2>
<p class="text-muted">@usuario.Nombre @usuario.Apellido</p>
<p>
    @foreach (var p in permisos)
    {
        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary me-1">@p</span>
    }
    @if (!permisos.Any()) { <span class="text-muted">Sin permisos asignados.</span> }
</p>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert"><i class="fa-solid fa-circle-check me-1"></i>@ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}

<form asp-action="Accesos" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="idUsuario" value="@usuario.IdUsuario" />
    <div class="card god-card">
        <div class="card-header py-3">Clínicas asignadas <small class="text-muted fw-normal">· marca la de inicio con "Default"</small></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 tabla-config" data-search-placeholder="Buscar clínica" data-export-name="AccesosClinicas">
                    <thead class="table-light"><tr><th style="width:3rem">Acceso</th><th>Clínica</th><th>Hospital</th><th style="width:6rem">Default</th><th class="text-end">Info</th></tr></thead>
                    <tbody>
                    @foreach (var c in clinicas)
                    {
                        <tr>
                            <td><input type="checkbox" class="form-check-input" name="clinicaIds" value="@c.IdClinica" @(ids.Contains(c.IdClinica) ? "checked" : "") /></td>
                            <td class="fw-semibold">@c.Nombre</td>
                            <td class="text-muted">@c.Hospital?.Nombre</td>
                            <td><input type="radio" class="form-check-input" name="defaultClinicaId" value="@c.IdClinica" @(def == c.IdClinica ? "checked" : "") /></td>
                            <td class="text-end"><partial name="_AuditInfo" model="c" /></td>
                        </tr>
                    }
                    @if (!clinicas.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Sin clínicas activas.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-dark" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>Guardar accesos</button>
        <a class="btn btn-outline-secondary" asp-action="Usuarios">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_DataTablesButtonsScripts" />
    <script src="~/js/pages/audit-info.js" asp-append-version="true"></script>
    <script src="~/js/pages/tablas-config.js" asp-append-version="true"></script>
}
