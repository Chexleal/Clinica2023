<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Traumha</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/limonte-sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.css" />
    @* FullCalendar v6 (index.global.min.js) inyecta sus propios estilos, no usar CSS v3 *@
    @await RenderSectionAsync("Links", required: false)
    <script src="https://kit.fontawesome.com/184a85cc88.js" crossorigin="anonymous"></script>
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    @{
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var isCatalogoEstudios = ctrl == "Estudios" && (act == "Catalogo" || act == "CrearCatalogo" || act == "ToggleCatalogo" || act == "EliminarCatalogo");
        var isConfig = ctrl == "Configuraciones" || isCatalogoEstudios || ctrl == "Servicios" || ctrl == "Inventario";
        var isEstudiosCarga = ctrl == "Estudios" && !isCatalogoEstudios;
        var pageTitle = ViewData["Title"]?.ToString() ?? ctrl;
    }

    <div class="app-shell">
        <nav class="menu" id="sidebar" aria-label="Navegación principal">
            <div class="logo">
                <a class="logo-button" href="/Inicio" aria-label="Traumha - Inicio">
                    <img src="~/img/NewLogoOp-sidebar.png" asp-append-version="true" alt="Traumha" class="button" />
                </a>
            </div>

            <div class="menu-scroll">
                <p class="menu-heading">Operación</p>
                <div class="botones btn-group-vertical">
                    <a class="menu_bt @((ctrl == "Pacientes") ? "active" : "")" href="/Pacientes" @((ctrl == "Pacientes") ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-solid fa-user-injured"></i></span><span>Pacientes</span></a>
                    <a class="menu_bt @((ctrl == "Consultas" || ctrl == "ContinuarConsulta") ? "active" : "")" href="/Consultas" @((ctrl == "Consultas" || ctrl == "ContinuarConsulta") ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-solid fa-notes-medical"></i></span><span>Consultas</span></a>
                    <a class="menu_bt @(isEstudiosCarga ? "active" : "")" href="/Estudios" @(isEstudiosCarga ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-solid fa-x-ray"></i></span><span>Estudios</span></a>
                    <a class="menu_bt @((ctrl == "Citas") ? "active" : "")" href="/Citas" @((ctrl == "Citas") ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-solid fa-calendar"></i></span><span>Citas</span></a>
                </div>

                <p class="menu-heading">Caja</p>
                <div class="botones btn-group-vertical">
                    <a class="menu_bt @((ctrl == "Pagos") ? "active" : "")" href="/Pagos" @((ctrl == "Pagos") ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-solid fa-money-bill"></i></span><span>Pagar Consultas</span></a>
                    <a class="menu_bt @((ctrl == "Ventas") ? "active" : "")" href="/Ventas" @((ctrl == "Ventas") ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-solid fa-cash-register"></i></span><span>Ventas Mostrador</span></a>
                    <a class="menu_bt @((ctrl == "Gastos") ? "active" : "")" href="/Gastos" @((ctrl == "Gastos") ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-solid fa-money-bill-wave"></i></span><span>Gastos</span></a>
                </div>

                <p class="menu-heading">Administración</p>
                <div class="botones btn-group-vertical">
                    <a class="menu_bt @((ctrl == "Reportes") ? "active" : "")" href="/Reportes" @((ctrl == "Reportes") ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-regular fa-file-lines"></i></span><span>Reportes</span></a>
                    <a class="menu_bt @((ctrl == "Usuarios") ? "active" : "")" href="/Usuarios" @((ctrl == "Usuarios") ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-solid fa-users"></i></span><span>Usuarios</span></a>
                    <a class="menu_bt @(isConfig ? "active" : "")" href="/Configuraciones" @(isConfig ? "aria-current=\"page\"" : "")><span class="menu_icon"><i class="fa-solid fa-gear"></i></span><span>Configuraciones</span></a>
                </div>
            </div>

            <div class="menu-footer">
                <span class="menu-version">Traumha · Clínica</span>
            </div>
        </nav>
        <div class="sidebar-overlay" id="sidebar-overlay" hidden></div>

        <div class="app-main">
            <header class="topbar">
                <button id="toggle-button" class="toggle-button" aria-controls="sidebar" aria-expanded="true" aria-label="Mostrar u ocultar menú">
                    <i class="fas fa-bars" aria-hidden="true"></i>
                </button>
                <div class="topbar-title">
                    <span class="topbar-breadcrumb">Traumha</span>
                    <h1 class="topbar-page">@pageTitle</h1>
                </div>
                <div class="topbar-user dropdown">
                    <button class="user-chip" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true" title="Cuenta">
                        <span class="user-avatar" id="avatarInicial" aria-hidden="true">U</span>
                        <span class="user-meta">
                            <span class="user-greeting">Hola</span>
                            <span class="user-name" id="nombreUsuario"></span>
                        </span>
                        <i class="fa-solid fa-chevron-down user-caret" aria-hidden="true"></i>
                    </button>
                    <ul class="menu-cuenta dropdown-menu dropdown-menu-end">
                        <li><button data-bs-toggle="modal" data-bs-target="#changePWModal" class="conf-option dropdown-item">Cambiar Contraseña</button></li>
                        <li><button onclick="logout()" class="conf-option dropdown-item">Cerrar Sesión</button></li>
                    </ul>
                </div>
            </header>

            <div class="container-larger mx-auto">
                <main role="main" id="contenido" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script>
        (function () {
            try {
                var raw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["UsuarioNombre"]?.ToString() ?? ""));
                if (raw) localStorage.setItem("UsuarioNombre", raw);
                var nombre = localStorage.getItem("UsuarioNombre") || "";
                var el = document.getElementById("nombreUsuario");
                if (el) el.textContent = nombre;
                var avatar = document.getElementById("avatarInicial");
                if (avatar) avatar.textContent = (nombre.trim().charAt(0) || "U").toUpperCase();
            } catch (e) { /* sin nombre de usuario disponible */ }
        })();
    </script>

    <script src="~/lib/limonte-sweetalert2/sweetalert2.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.js"></script>
    <script src="~/js/index.global.min.js"></script>
    <script src="~/js/es.global.js"></script>
    <script src="~/js/select2.min.js"></script>
    <script src="~/js/datatables.common.js"></script>



    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)



</body>
</html>



<!-- Modal Cambiar Constraseña-->
<div class="modal fade" id="changePWModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Cambiar Contraseña</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form id="changePWForm" asp-action="ChangePassWord" asp-controller="Home" method="post">
                        <div class="row">
                            <div class="form-group">
                                <label class="control-label">Contraseña</label>
                                <input required name="Password" id="Password" class="form-control" />
                            </div>
                            <br>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" form="changePWForm">Guardar</button>
            </div>

        </div>
    </div>
</div>
