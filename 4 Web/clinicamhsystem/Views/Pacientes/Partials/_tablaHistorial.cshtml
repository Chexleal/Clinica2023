@using ClinicaDomain
@using ClinicaInfrastructure

@{
    var ventasPorConsulta = (Dictionary<Guid, List<Venta>>)(ViewBag.VentasPorConsulta ?? new Dictionary<Guid, List<Venta>>());
    var saldos = (Dictionary<Guid, decimal>)(ViewBag.Saldos ?? new Dictionary<Guid, decimal>());
    var libres = (List<Venta>)(ViewBag.VentasLibres ?? new List<Venta>());
    decimal SaldoDe(Venta v) => saldos.TryGetValue(v.IdVenta, out var s) ? s : v.Total;
}

<div class=" table-responsive">
    <table id="table" class="table table-striped ">
        <thead class="table-dark">
            <tr>
                <th>Fecha de creación</th>
                <th>Motivo de consulta</th>
                <th>Diagnostico</th>
                <th>Observaciones</th>
                <th>Cobro</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var consulta in Model)
            {
                List<Venta> ventas = ventasPorConsulta.ContainsKey(consulta.IdConsulta) ? ventasPorConsulta[consulta.IdConsulta] : new List<Venta>();
                var principal = ventas.FirstOrDefault(v => v.Estado == "Pendiente" || v.Estado == "Pendiente de pago")
                    ?? ventas.OrderByDescending(v => v.Fecha).FirstOrDefault();
                <tr>
                    <td>@DateManager.GetDisplayDate(consulta.FechaCreacion, consulta.Fecha).ToString("dd/MM/yyyy")</td>
                    <td data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="hover focus" data-bs-content="@consulta.MotivoConsulta">@StringManager.CutOnMax(consulta.MotivoConsulta, 40)</td>
                    <td data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="hover focus" data-bs-content="@consulta.Diagnostico">@StringManager.CutOnMax(consulta.Diagnostico, 40)</td>
                    <td data-bs-toggle="popover" data-bs-placement="top" data-bs-trigger="hover focus" data-bs-content="@consulta.Observaciones">@StringManager.CutOnMax(consulta.Observaciones, 40)</td>
                    <td>
                        @if (principal is null)
                        {
                            <span class="badge bg-light text-dark border">Sin cuenta</span>
                        }
                        else
                        {
                            <div class="small"><b>@principal.Folio</b> · Q@(principal.Total.ToString("0.00"))</div>
                            <span class="badge @(principal.Estado == "Pagada" ? "bg-success" : principal.Estado == "Anulada" ? "bg-secondary" : "bg-warning text-dark")">@principal.Estado</span>
                            @if (principal.Estado == "Pendiente de pago")
                            {
                                <div class="small fw-bold">Saldo Q@(SaldoDe(principal).ToString("0.00"))</div>
                            }
                            @if (ventas.Count > 1)
                            {
                                <div class="small text-muted">+@(ventas.Count - 1) cuenta(s)</div>
                            }
                        }
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            <a class="btn btn-outline-info btn-sm" href="@Url.Action("Index", "ContinuarConsulta", new { consultaId = consulta.IdConsulta })">Ver</a>
                            @if (principal is not null && (principal.Estado == "Pendiente" || principal.Estado == "Pendiente de pago"))
                            {
                                <a class="btn btn-outline-warning btn-sm" href="@Url.Action("Cobrar","Ventas",new{id=principal.IdVenta})">Cobrar</a>
                                <a class="btn btn-link btn-sm" href="@Url.Action("Index","Pagos")">Ir a caja</a>
                            }
                            else if (principal is not null)
                            {
                                <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Ver","Ventas",new{id=principal.IdVenta})">Ver cuenta</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <h6 class="fw-bold">Compras de mostrador del paciente @(libres.Any() ? $"({libres.Count})" : "")</h6>
    @if (!libres.Any())
    {
        <p class="text-muted small mb-0">Sin compras de mostrador.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead class="table-dark">
                    <tr><th>Folio</th><th>Fecha</th><th class="text-end">Total</th><th class="text-end">Saldo</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var v in libres)
                    {
                        <tr>
                            <td>@v.Folio</td>
                            <td>@v.Fecha.ToString("g")</td>
                            <td class="text-end">Q@(v.Total.ToString("0.00"))</td>
                            <td class="text-end fw-bold">Q@(SaldoDe(v).ToString("0.00"))</td>
                            <td><span class="badge @(v.Estado == "Pagada" ? "bg-success" : v.Estado == "Anulada" ? "bg-secondary" : "bg-warning text-dark")">@v.Estado</span></td>
                            <td class="text-end">
                                @if (v.Estado == "Pendiente" || v.Estado == "Pendiente de pago")
                                {
                                    <a class="btn btn-outline-warning btn-sm" href="@Url.Action("Cobrar","Ventas",new{id=v.IdVenta})">Cobrar</a>
                                }
                                else
                                {
                                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Ver","Ventas",new{id=v.IdVenta})">Ver cuenta</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
